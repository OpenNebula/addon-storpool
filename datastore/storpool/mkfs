#-------------------------------------------------------------------------------
# mkfs base64drvActionXML id
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# Set up the environment to source common tools
#-------------------------------------------------------------------------------

SIZE=0

if [[ -n "${ONE_LOCATION}" ]]; then
    LIB_LOCATION="${ONE_LOCATION}/lib"
else
    LIB_LOCATION="/usr/lib/one"
fi
# shellcheck source=/dev/null
source "${LIB_LOCATION}/sh/scripts_common.sh"

DRIVER_PATH="$(dirname "$0")"
# shellcheck source=/dev/null
source "${DRIVER_PATH}/../libfs.sh"

if [[ -f "${DRIVER_PATH}/../../etc/datastore/datastore.conf" ]]; then
    # shellcheck source=/dev/null
    source "${DRIVER_PATH}/../../etc/datastore/datastore.conf"
fi

export LOG_PREFIX="ds"

# shellcheck source=tm/storpool/storpool_common.sh
source "${DRIVER_PATH}/../../tm/storpool/storpool_common.sh"

#-------------------------------------------------------------------------------
# Get mkfs and datastore arguments from OpenNebula core
#-------------------------------------------------------------------------------

if [[ -n "${2}" ]]; then
    DRV_ACTION="${1}"
    ID="${2}"
else
    DRV_ACTION="$(cat)"
    ID="${1}"
fi

export DRV_ACTION

oneDsDriverAction

if [[ -n "${DRIVER}" ]] && [[ "${DRIVER,,}" != "raw" ]]; then
    log_error "Unsupported DRIVER format '${DRIVER}'! Please use 'raw'."
    splog "Unsupported DRIVER format '${DRIVER}'! Please use 'raw'."
    exit 1
fi

#-------------------------------------------------------------------------------
# Get datastore host, validate variables and set up datastore
#-------------------------------------------------------------------------------

if [[ -n "${BRIDGE_LIST}" ]]; then
    DST_HOST="$(get_destination_host "${ID}")"

    if [[ -z "${DST_HOST}" ]]; then
        error_message "Datastore template missing 'BRIDGE_LIST' attribute."
        exit 255
    fi
fi

set_up_datastore "${BASE_PATH:-/var/lib/one}" "${RESTRICTED_DIRS:+/etc}" "${SAFE_DIRS:+/var/tmp}"

#IMAGE_HASH="$(generate_image_hash)"

SP_VOL="${ONE_PX}-img-${ID}"
# the image SOURCE keeps the <prefix>-ds-<id>/ form regardless of the template
SP_DST="${ONE_PX}-ds-${DATASTORE_ID:-}/${SP_VOL}"
SP_TEMPLATE="$(spVolumeTemplateName "${DATASTORE_ID}")"

#-------------------------------------------------------------------------------
# Image FSTYPE:save_as. If it is HOT snapshot then tm/cpds will take care of it later
#-------------------------------------------------------------------------------

case "${FSTYPE,,}" in
    raw|'')
        echo "${SP_DST}"
        ;;
    save_as)
        echo "${SP_DST}"
        splog "END FSTYPE=${FSTYPE} return:${SP_DST}"
        exit 0
        ;;
    *)
        log_error "Unsupported FSTYPE '${FSTYPE}'! Please use 'raw'."
        splog "Unsupported FSTYPE '${FSTYPE}'! Please use 'raw'."
        exit 1
esac

if [[ ${FORMAT,,} == "save_as" ]]; then
    echo "${SP_DST}"
    splog "END FORMAT=${FORMAT} return:${SP_DST}"
    exit 0
fi

if boolTrue "SAVE_AS_HOT"; then
    echo "${SP_DST}"
    splog "END SAVED_VM_ID=${SAVED_VM_ID} SAVED_DISK_ID=${SAVED_DISK_ID} return:${SP_DST} (SAVE_AS_HOT)"
    exit 0
fi

# Reject an unknown FS before the volume exists. OpenNebula's fs and fs_lvm
# drivers fail the action; clearing FS and returning a raw volume leaves the
# image recorded as formatted.
_SUPPORTED_FS="${SUPPORTED_FS:-ext2,ext3,ext4,xfs}"
if [[ -n "${FS}" ]]; then
    if ! type -t contains &>/dev/null; then
        msg="Cannot check FS='${FS}': contains() is not defined"
        log_error "${msg}"
        splog "${msg}"
        exit 1
    fi
    if ! contains "${_SUPPORTED_FS}" "${FS}" ","; then
        msg="Unsupported file system type: ${FS}. Supported types are: ${_SUPPORTED_FS}"
        log_error "${msg}"
        splog "${msg}"
        exit 1
    fi
    splog "FS:'${FS}' is SUPPORTED_FS:${_SUPPORTED_FS}"
fi

storpoolVolumeCheck "${SP_VOL}" byName

#-------------------------------------------------------------------------------
# Create the image in the datastore
#-------------------------------------------------------------------------------

if storpoolVolumeCreate "${SP_VOL}" "$((SIZE*1024*1024))" "${SP_TEMPLATE}"; then
    VOL_UID="${SP_UID}"
    SP_LINK="/dev/storpool-byid/${VOL_UID#*~}"
else
    splog "[E] Failed to create volume ${SP_VOL} ($?)"
    exit 1
fi

if [[ -n "${FSTYPE}" && "${FSTYPE,,}" != "raw" ]] || [[ -n "${FS}" ]]; then
    if boolTrue "DEBUG_DS_MKFS"; then
        splog "FSTYPE='${FSTYPE}' FS='${FS}'"
    fi
    trapAdd "storpoolDelete \"${VOL_UID}\" force snaps"
    trapAdd "splog \"trap errno \$? \""

    storpoolAttach "${VOL_UID}" "${DST_HOST}"

    if [[ -n "${FS}" ]]; then
        FS_OPTS="FS_OPTS_${FS}"
        case "${FS,,}" in
            xfs|btrfs) MKFS_FORCE="-f" ;;
            ext*)      MKFS_FORCE="-F" ;;
            *)         MKFS_FORCE="" ;;
        esac
        # mkfs on a block device needs CAP_SYS_ADMIN (BLKBSZSET). OpenNebula
        # 7.4.1+ allows this via the ONE_FS alias (OpenNebula/one#7746), which
        # is /usr/sbin/mkfs only, so call that wrapper. Older releases need
        # the same sudoers entry; see docs/installation.md. -t is before
        # -f/-F so util-linux passes the force flag through (OpenNebula/one#5810).
        MKFS_CMD="${SUDO:-sudo -n} /usr/sbin/mkfs -t \"${FS}\" ${MKFS_FORCE} ${!FS_OPTS} \"${SP_LINK}\""
    else
        MKFS_CMD="$(mkfs_command "${SP_LINK}" "${FSTYPE}" "${SIZE}")"
    fi

    if [[ -n "${DST_HOST}" ]]; then
        splog "run mkfs on ${DST_HOST} (${MKFS_CMD})"
        ssh_exec_and_log "${DST_HOST}" "${MKFS_CMD}" \
                     "Error processing ${SP_VOL} on ${DST_HOST}"
    else
        splog "run mkfs local (${MKFS_CMD})"
        exec_and_log "${MKFS_CMD}" \
                     "Error processing ${SP_VOL}"
        splog "run mkfs completed"
    fi

    trapReset

    storpoolDetach "${VOL_UID}" "" "${DST_HOST}"
fi

SP_QOSCLASS="${IMAGE_SP_QOSCLASS:-${DS_SP_QOSCLASS:-${DEFAULT_QOSCLASS}}}"
debug_sp_qosclass

storpoolVolumeFreeze "${VOL_UID}" "volume" "virt;${LOC_TAG:-nloc};qc" "one;${LOC_TAG_VAL};${SP_QOSCLASS}"
_ret=$?
if [[ ${_ret} -ne 0 ]]; then
    splog "[E] ${VOL_UID} (${SP_VOL}) not frozen (${_ret})"
    exit "${_ret}"
fi

splog "END ${SP_DST} ${VOL_UID}"
