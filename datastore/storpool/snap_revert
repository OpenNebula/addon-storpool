#-------------------------------------------------------------------------------
# snap_revert base64drvActionXML id
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# Set up the environment to source common tools
#-------------------------------------------------------------------------------

if [[ -n "${ONE_LOCATION}" ]]; then
    LIB_LOCATION="${ONE_LOCATION}/lib"
else
    LIB_LOCATION="/usr/lib/one"
fi
# shellcheck source=/dev/null
source "${LIB_LOCATION}/sh/scripts_common.sh"

DRIVER_PATH="$(dirname "$0")"

# shellcheck source=/dev/null
source "${DRIVER_PATH}/../libfs.sh"

export LOG_PREFIX="ds"

# shellcheck source=tm/storpool/storpool_common.sh
source "${DRIVER_PATH}/../../tm/storpool/storpool_common.sh"

#-------------------------------------------------------------------------------
# Get stat and datastore arguments from OpenNebula core
#-------------------------------------------------------------------------------

if [[ -n "$2" ]]; then
    DRV_ACTION="$1"
    ID="$2"
else
    DRV_ACTION="$(cat)"
    ID="$1"
fi

oneDsDriverAction

SP_VOL="${SOURCE##*/}"
SP_SNAP="${SP_VOL}-snap${TARGET_SNAPSHOT}"

if boolTrue "DISKSNAPSHOT_REVERT_STRICT"; then
    kvGetUid "${SP_SNAP}" fatal
else
    kvGetUid "${SP_SNAP}"
    _kvret=$?
    if [[ ${_kvret} -eq 2 ]]; then
        splog "[E] Can't look up ${SP_SNAP} for ${SP_VOL} (${_kvret})"
        exit "${_kvret}"
    elif [[ ${_kvret} -ne 0 ]]; then
        splog "[W] Can't find ${SP_SNAP} for ${SP_VOL}, skipping the revert (DISKSNAPSHOT_REVERT_STRICT=0)"
        splog "END"
        exit 0
    fi
fi

storpoolSnapshotRevert "${SP_UID}" "${SP_VOL}" "IS_SNAPSHOT"

SP_QOSCLASS="${IMAGE_SP_QOSCLASS:-${DS_SP_QOSCLASS:-${DEFAULT_QOSCLASS}}}"
debug_sp_qosclass

storpoolSnapshotTag "${SP_UID}" "virt;${LOC_TAG:-nloc};qc" "one;${LOC_TAG_VAL};${SP_QOSCLASS}"

splog "END"
