DRIVER_PATH="$(dirname "$0")"
export LOG_PREFIX="ds"

# run by the TM restore: a temp dir inherited from it would be removed on exit
unset TMPDIR

# shellcheck source=/dev/null
source "${DRIVER_PATH}/../../scripts_common.sh"
# shellcheck source=tm/storpool/storpool_common.sh
source "${DRIVER_PATH}/../../tm/storpool/storpool_common.sh"

INC_ID="-1"
while [[ $# -gt 0 ]]; do
    case "$1" in
        -i) INC_ID="$2"; shift 2 ;;
        *) shift ;;
    esac
done

if [[ "${INC_ID}" != "-1" ]]; then
    msg="ls: increments are not supported on a StorPool backup datastore (-i ${INC_ID})"
    error_message "${msg}"
    splog "${msg}"
    exit 1
fi

DRV_ACTION="$(base64 -w0)"
export DRV_ACTION
oneDsDriverAction

if ! oneBackupSourceParse "${SOURCE}"; then
    msg="ls: not a StorPool backup SOURCE '${SOURCE}'"
    error_message "${msg}"
    splog "${msg}"
    exit 1
fi

if [[ "${BS_LOCATION}" == "local" ]]; then
    PREFIX="SPSNAPSHOT:~"
else
    PREFIX="SPREMOTE:${BS_LOCATION}:~"
fi

JSON=""
for did in ${BS_DISK_IDS}; do
    JSON+="${JSON:+,}\"${did}\":\"${PREFIX}${BS_IDS_A[${did}]}\""
done
[[ -z "${BS_IDS_A[nvram]:-}" ]] || JSON+="${JSON:+,}\"nvram\":\"${PREFIX}${BS_IDS_A[nvram]}\""
[[ -z "${BS_IDS_A[svc]:-}" ]] || JSON+="${JSON:+,}\"svc\":\"${PREFIX}${BS_IDS_A[svc]}\""

echo "{${JSON}}"
splog "END {${JSON}}"
exit 0
