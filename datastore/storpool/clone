#-------------------------------------------------------------------------------
# clone base64drvActionXML id
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# Set up the environment to source common tools
#-------------------------------------------------------------------------------

if [[ -n "${ONE_LOCATION}" ]]; then
    LIB_LOCATION="${ONE_LOCATION}/lib"
else
    LIB_LOCATION="/usr/lib/one"
fi

# shellcheck source=/dev/null
source "${LIB_LOCATION}/sh/scripts_common.sh"

DRIVER_PATH="$(dirname "$0")"
# shellcheck source=/dev/null
source "${DRIVER_PATH}/../libfs.sh"

export LOG_PREFIX="ds"

# shellcheck source=tm/storpool/storpool_common.sh
source "${DRIVER_PATH}/../../tm/storpool/storpool_common.sh"

#-------------------------------------------------------------------------------
# Get clone and datastore arguments from OpenNebula core
#-------------------------------------------------------------------------------

if [[ -n "$2" ]]; then
    DRV_ACTION="$1"
    ID="$2"
else
    DRV_ACTION="$(cat)"
    ID="$1"
fi

oneDsDriverAction
IMAGE_DS_SP_QOSCLASS="${DS_SP_QOSCLASS}"

SP_VOL="${ONE_PX:-one}-img-${ID}"
SP_PARENT="${IMAGE_PATH##*/}"
# the image SOURCE keeps the <prefix>-ds-<id>/ form regardless of the template
SP_DST="${ONE_PX:-one}-ds-${DATASTORE_ID}/${SP_VOL}"
SP_TEMPLATE="$(spVolumeTemplateName "${DATASTORE_ID}")"
PARENT_UID=$(kvGet byName "${SP_PARENT}")

if [[ -z "${PARENT_UID}" ]]; then
    errmsg="Error: Can't get StorPool UID for image ${SP_PARENT}!"
    splog "${errmsg}"
    log "${errmsg}"
    exit 255
fi

echo "${SP_DST}"

SRC_REMOTE=""
DST_REMOTE=""

function cloneApi()
{
    local _i=0
    local -a _names=(SP_API_HTTP_HOST SP_API_HTTP_PORT SP_AUTH_TOKEN SP_CLUSTER_ID) _vals=()
    if [[ "$1" == "SRC" ]]; then
        _vals=("${SRC_SP_API_HTTP_HOST}" "${SRC_SP_API_HTTP_PORT}" "${SRC_SP_AUTH_TOKEN}" "${SRC_SP_CLUSTER_ID}")
    else
        _vals=("${DST_SP_API_HTTP_HOST}" "${DST_SP_API_HTTP_PORT}" "${DST_SP_AUTH_TOKEN}" "${DST_SP_CLUSTER_ID}")
    fi
    for _i in "${!_names[@]}"; do
        if [[ -n "${_vals[_i]}" ]]; then
            export "${_names[_i]}=${_vals[_i]}"
        else
            unset "${_names[_i]}"
        fi
    done
}

function cloneFail()
{
    splog "[E] $1"
    log_error "$1"
    error_message "$1"
    exit 255
}

function cloneApiRemote()
{
    local _side="$1" _api="" _cluster="${DST_SP_CLUSTER_ID}" _ds="${DATASTORE_ID}"
    if [[ "${_side}" == "SRC" ]]; then
        _cluster="${SRC_SP_CLUSTER_ID}"
        _ds="${SRC_DS_ID}"
    fi
    cloneApi "${_side}"
    _api="$(storpoolApiClusterId)"
    [[ -n "${_api}" ]] || cloneFail "Can't reach the StorPool API of datastore ${_ds}"
    printf -v "${_side}_REMOTE" '%s' ""
    [[ "${_api}" != "${_cluster}" ]] || return 0
    if [[ "${_api%%.*}" != "${_cluster%%.*}" ]]; then
        cloneFail "Datastore ${_ds} on ${_cluster} needs its own SP_API_HTTP_HOST and SP_AUTH_TOKEN (the API serves ${_api})"
    fi
    printf -v "${_side}_REMOTE" '%s' "~${_cluster}"
    export MULTICLUSTER=1 SP_LOCATION=""
}

function cloneBridgeUnexport()
{
    cloneApi SRC
    DO_MULTICLUSTER="" DO_REMOTE="${SRC_REMOTE}" NO_MC_RETRY=1 _SOFT_FAIL=1 storpoolRetry SnapshotUnexport \
        "\"snapshot\":\"${PARENT_UID}\",\"location\":\"${DST_LOCATION}\"" >/dev/null \
        || splog "[W] ${PARENT_UID} not unexported from ${DST_LOCATION} ($?)"
    cloneApi DST
}

function cloneBridgePullDrop()
{
    [[ -n "${PULLED_NAME}" ]] || return 0
    cloneApi DST
    storpoolPulledSnapshotDrop "${PULLED_NAME}" && PULLED_NAME=""
}

function cloneViaBridge()
{
    local _lock="/var/lock/one/sp-clone-${PARENT_UID#\~}.lock" _ret=0 _exported="" _parent=""
    cloneApi SRC
    SRC_LOCATION="$(spLocationName "${SRC_SP_CLUSTER_ID%%.*}")"
    DST_LOCATION="$(spLocationName "${DST_SP_CLUSTER_ID%%.*}")"
    if [[ -z "${SRC_LOCATION}" ]] || [[ -z "${DST_LOCATION}" ]]; then
        cloneFail "Can't resolve the StorPool locations of ${SRC_SP_CLUSTER_ID} and ${DST_SP_CLUSTER_ID}"
    fi
    cloneApiRemote SRC
    cloneApiRemote DST
    export SP_PULL_REMOTE="${DST_REMOTE}"
    cloneApi SRC
    splog "[I] ${PARENT_UID} ${SRC_SP_CLUSTER_ID} (${SRC_LOCATION}) --> ${DST_SP_CLUSTER_ID} (${DST_LOCATION}) via the StorPool bridge as ${SP_VOL}${SRC_REMOTE:+ source:RemoteCommand/${SRC_REMOTE}}${DST_REMOTE:+ destination:RemoteCommand/${DST_REMOTE}}"
    if exec {CLONE_LOCK_FD}>"${_lock}"; then
        flock -x "${CLONE_LOCK_FD}"
    else
        splog "[W] can't open ${_lock}, concurrent clones of ${PARENT_UID} are not serialized"
    fi

    storpoolSnapshotExported "${PARENT_UID}" "${DST_LOCATION}" "${SRC_REMOTE}"
    _ret=$?
    case ${_ret} in
        0)
            splog "[I] ${PARENT_UID} is already exported to ${DST_LOCATION}, left exported"
            ;;
        1)
            DO_MULTICLUSTER="" DO_REMOTE="${SRC_REMOTE}" NO_MC_RETRY=1 _SOFT_FAIL=1 storpoolRetry SnapshotExport \
                "\"snapshot\":\"${PARENT_UID}\",\"location\":\"${DST_LOCATION}\"" >/dev/null \
                || cloneFail "Can't export ${PARENT_UID} to ${DST_LOCATION}"
            _exported=1
            trapAdd "cloneBridgeUnexport"
            ;;
        *)
            cloneFail "Can't list the StorPool exports of ${SRC_LOCATION}"
            ;;
    esac

    oneDsDriverAction
    IMAGE_DS_SP_QOSCLASS="${DS_SP_QOSCLASS}"
    SP_QOSCLASS="${IMAGE_SP_QOSCLASS:-${IMAGE_DS_SP_QOSCLASS:-${DEFAULT_QOSCLASS}}}"
    debug_sp_qosclass
    cloneApi DST

    storpoolRemoteCopiesWait "${PARENT_UID}" "${CLONE_EXPORT_WAIT:-60}" \
        || cloneFail "${PARENT_UID} exported by ${SRC_LOCATION} is not listed in ${DST_LOCATION}"
    PULL_TEMPLATE="$(SP_CLUSTER_ID="${DST_SP_CLUSTER_ID}" spBackupPullTemplate "${SP_TEMPLATE}")"
    [[ -n "${PULL_TEMPLATE}" ]] || cloneFail "No StorPool template in ${DST_SP_CLUSTER_ID} for the pull of ${PARENT_UID}: set the default template of that cluster (MgmtConfig)"
    PULL_NAME="${SP_VOL}-pull-$(mktemp --dry-run XXXXXXXX)"
    storpoolSnapshotPullRemote "${PULL_NAME}" "${PARENT_UID}" "${SRC_LOCATION}" "${PULL_TEMPLATE}" \
        "img;${LOC_TAG:-nloc};virt" "${PULL_NAME};${LOC_TAG_VAL};one" \
        || cloneFail "Can't pull ${PARENT_UID} from ${SRC_LOCATION} to ${DST_LOCATION}"
    [[ -n "${SP_PULL_NAME}" ]] || cloneFail "No name for the pulled ${PARENT_UID} in ${DST_SP_CLUSTER_ID}"
    if [[ -z "${SP_PULL_REUSED}" ]] || [[ "${SRC_LOCATION}" == "${DST_LOCATION}" ]]; then
        PULLED_NAME="${SP_PULL_NAME}"
        trapAdd "cloneBridgePullDrop"
    fi

    _parent="${SP_UID}"
    [[ -z "${DST_REMOTE}" ]] || _parent="${SP_PULL_NAME}"
    storpoolVolumeFromPulledSnapshot "${_parent}" "${SP_VOL}" "${PULL_TEMPLATE}" \
        || cloneFail "Can't create ${SP_VOL} from the pulled ${PARENT_UID}"
    DST_VOL_UID="${SP_UID}"
    if [[ "${SRC_LOCATION}" == "${DST_LOCATION}" ]]; then
        DO_MULTICLUSTER="" DO_REMOTE="${SP_PULL_REMOTE-}" NO_MC_RETRY=1 _SOFT_FAIL=1 storpoolRetry VolumeRebase "${DST_VOL_UID}" "" >/dev/null
        _ret=$?
        if [[ ${_ret} -ne 0 ]]; then
            DELAY_DELETE="" _SOFT_FAIL=1 storpoolDelete "${DST_VOL_UID}" "force"
            cloneFail "${DST_VOL_UID} (${SP_VOL}) not detached from the pulled ${PARENT_UID} (${_ret})"
        fi
    fi
    if [[ -n "${PULLED_NAME}" ]]; then
        trapDel "cloneBridgePullDrop"
        cloneBridgePullDrop || splog "[W] pulled snapshot ${PULLED_NAME} not deleted ($?)"
    fi

    _SOFT_FAIL=1 storpoolVolumeFreeze "${DST_VOL_UID}" "volume" "virt;${LOC_TAG:-nloc};qc" "one;${LOC_TAG_VAL};${SP_QOSCLASS}"
    _ret=$?
    if [[ ${_ret} -ne 0 ]]; then
        DELAY_DELETE="" _SOFT_FAIL=1 storpoolDelete "${DST_VOL_UID}" "force"
        cloneFail "${DST_VOL_UID} (${SP_VOL}) pulled but not frozen (${_ret})"
    fi

    if [[ -n "${_exported}" ]]; then
        trapDel "cloneBridgeUnexport"
        cloneBridgeUnexport
    fi
    if [[ "${SP_UID#\~}" != "${DST_SP_CLUSTER_ID}".* ]]; then
        cloneFail "${SP_VOL} is ${SP_UID}, not in ${DST_SP_CLUSTER_ID}"
    fi
    splog "DS ${SRC_DS_ID} (${SRC_SP_CLUSTER_ID}) --> ${DATASTORE_ID} (${DST_SP_CLUSTER_ID}), ${PARENT_UID} -> ${SP_UID} via the StorPool bridge"
}

#-------------------------------------------------------------------------------
# Clone Image
#-------------------------------------------------------------------------------

SRC_DS_ID="${IMAGE_PATH%%/*}"
SRC_DS_ID="${SRC_DS_ID##*-}"

if [[ "${SRC_DS_ID}" -ne "${DATASTORE_ID}" ]]; then
    DST_SP_API_HTTP_HOST="${SP_API_HTTP_HOST}"
    DST_SP_API_HTTP_PORT="${SP_API_HTTP_PORT}"
    DST_SP_AUTH_TOKEN="${SP_AUTH_TOKEN}"
    DST_SP_CLUSTER_ID="${SP_CLUSTER_ID}"

    oneDatastoreInfo "${SRC_DS_ID}"
    SRC_SP_API_HTTP_HOST="${SP_API_HTTP_HOST}"
    SRC_SP_API_HTTP_PORT="${SP_API_HTTP_PORT}"
    SRC_SP_AUTH_TOKEN="${SP_AUTH_TOKEN}"
    SRC_SP_CLUSTER_ID="${SP_CLUSTER_ID}"
    splog "${SP_PARENT} --> ${SP_VOL}"
    if [[ "${DS_TM_MAD}" != "${TM_MAD}" ]]; then
        splog "Clone from ${TM_MAD} to ${DS_TM_MAD} is not supported!"
        log "Clone from ${TM_MAD} to ${DS_TM_MAD} is not supported!"
        exit 255
    fi

    cloneApi SRC
    SRC_SP_CLUSTER_ID="${SRC_SP_CLUSTER_ID:-$(storpoolApiClusterId)}"
    cloneApi DST
    DST_SP_CLUSTER_ID="${DST_SP_CLUSTER_ID:-$(storpoolApiClusterId)}"
    if [[ -z "${SRC_SP_CLUSTER_ID}" ]] || [[ -z "${DST_SP_CLUSTER_ID}" ]]; then
        cloneFail "Can't get the StorPool clusters of datastores ${SRC_DS_ID} and ${DATASTORE_ID}"
    fi
    if [[ "${SRC_SP_CLUSTER_ID}" != "${DST_SP_CLUSTER_ID}" ]]; then
        cloneApi SRC
        PARENT_SP_CLUSTER_ID=""
        if DO_MULTICLUSTER=1 DO_REMOTE="" _SOFT_FAIL=1 storpoolRetry Snapshot "${PARENT_UID}" >/dev/null; then
            PARENT_SP_CLUSTER_ID="$(jq -r '.data[0].clusterId // empty' "${TMPDIR}/Snapshot.json" 2>/dev/null || true)"
        fi
        if [[ "${PARENT_SP_CLUSTER_ID}" != "${DST_SP_CLUSTER_ID}" ]]; then
            cloneViaBridge
            exit 0
        fi
        splog "[I] ${PARENT_UID} is in ${DST_SP_CLUSTER_ID} already"
    fi
    oneDsDriverAction
fi

storpoolVolumeCheck "${SP_VOL}" byName

storpoolVolumeFromSnapshot "${PARENT_UID}" "${SP_VOL}"
_ret=$?
if [[ ${_ret} -ne 0 ]]; then
    errmsg="Error: ${SP_VOL} not created from ${PARENT_UID} (${_ret})"
    splog "${errmsg}"
    log "${errmsg}"
    exit "${_ret}"
fi

SP_QOSCLASS="${IMAGE_SP_QOSCLASS:-${IMAGE_DS_SP_QOSCLASS:-${DEFAULT_QOSCLASS}}}"
debug_sp_qosclass

_VOL_UID="${SP_UID}"
_SOFT_FAIL=1 storpoolVolumeFreeze "${_VOL_UID}" "volume" "virt;${LOC_TAG:-nloc};qc" "one;${LOC_TAG_VAL};${SP_QOSCLASS}"
_ret=$?
if [[ ${_ret} -ne 0 ]]; then
    errmsg="Error: ${_VOL_UID} (${SP_VOL}) not frozen (${_ret})"
    splog "${errmsg}"
    log "${errmsg}"
    DELAY_DELETE="" _SOFT_FAIL=1 storpoolDelete "${_VOL_UID}" "force"
    exit "${_ret}"
fi

splog "END ${SP_DST}"
