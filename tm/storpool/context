# context context.sh file1 file2 ... fileN host:remote_system_ds/disk.i vmid dsid
#   - context.sh file are the contents of the context ISO
#   - host is the target host to deploy the VM
#   - remote_system_ds is the path for the system datastore in the host
#   - vmid is the id of the VM
#   - dsid is the target datastore (system)

#-------------------------------------------------------------------------------
# Get context arguments from OpenNebula core
#-------------------------------------------------------------------------------


ARGV=("$@")

DS_ID="${ARGV[$(($#-1))]}"
VM_ID="${ARGV[$(($#-2))]}"
DST="${ARGV[$(($#-3))]}"
read -r -a SRC <<< "${ARGV[@]:0:$(($#-3))}"

TM_PATH="$(dirname "$0")"

# shellcheck source=tm/storpool/storpool_common.sh
source "${TM_PATH}/storpool_common.sh"

splog "DS_ID=${DS_ID} VM_ID=${VM_ID} DST=${DST} SRC=${SRC[*]}"

function exit_error()
{
    error_message "${ERROR}"
    splog "${ERROR}"
    [[ -d "${ISO_DIR}" ]] && rm -rf "${ISO_DIR}" > /dev/null 2>&1
    [[ -f "${ISO_FILE}" ]] && rm -f "${ISO_FILE}" > /dev/null 2>&1
    exit 255
}

#-------------------------------------------------------------------------------
# Get Datastore information
#-------------------------------------------------------------------------------

oneDatastoreInfo "${DS_ID}"

#-------------------------------------------------------------------------------
# Set dst path and dirs
#-------------------------------------------------------------------------------

DST_PATH="$(arg_path "${DST}")"
DST_HOST="$(arg_host "${DST}")"
DST_DIR="$(dirname "${DST_PATH}")"

DISK_ID="$(echo "${DST}" | awk -F. '{print $NF}')"

#-------------------------------------------------------------------------------
# Build the Context Block device (locally) and copy it remotely
#-------------------------------------------------------------------------------

log "Generating context block device"

ISO_DIR="${DST_DIR}/.isofiles/${VM_ID}"
ISO_FILE="${DST_DIR}/.isofiles/${VM_ID}.iso"

# Drop leftovers from an aborted earlier attempt before reusing the directory
exec_and_set_error "rm -rf ${ISO_DIR} ${ISO_FILE}" \
    "Could not delete tmp dir to make context dev"
[[ -n "${ERROR}" ]] && exit_error

exec_and_set_error "mkdir -p ${ISO_DIR}" \
    "Could not create tmp dir to make context dev"
[[ -n "${ERROR}" ]] && exit_error

for f in "${SRC[@]}"; do
    case "${f}" in
    http://*)
        exec_and_set_error "${WGET:-wget} -P '${ISO_DIR}' ${f}" "Error downloading ${f}"
        ;;
    *)
        if echo "${f}" | grep -q ':'; then
            target="$(echo "${f}" | cut -d':' -f2-)"
            target="'${target}'"
            f="$(echo "${f}" | cut -d':' -f1)"
        else
            target=""
        fi

        exec_and_set_error "cp -R ${f} ${ISO_DIR}/${target}" \
            "Error copying ${f} to ${ISO_DIR}"
        ;;
    esac

    [[ -n "${ERROR}" ]] && exit_error
done

oneVmInfo "${VM_ID}" 0

SP_QOSCLASS="${VM_SP_QOSCLASS:-${DS_SP_QOSCLASS:-${DEFAULT_QOSCLASS}}}"
debug_sp_qosclass

if boolTrue "INCLUDE_CONTEXT_PACKAGES"; then
    if [[ -d "/usr/share/one/context" ]]; then
        exec_and_set_error "rsync -a --exclude='*.iso' /usr/share/one/context/* '${ISO_DIR}'/" \
            "Error copying /usr/share/one/context/* to ${ISO_DIR}"
    fi
fi

# 6.4..7.0 set MKISOFS=genisoimage. 7.2+ removed it and call
# "xorriso -as mkisofs" with the same flags (OpenNebula/one#4059).
if [[ -n "${MKISOFS}" ]]; then
    ISO_CMD="${MKISOFS}"
elif command -v xorriso >/dev/null 2>&1; then
    ISO_CMD="xorriso -as mkisofs"
else
    ISO_CMD="genisoimage"
fi
exec_and_set_error "${ISO_CMD} -o ${ISO_FILE} -V CONTEXT -J -R ${ISO_DIR}" \
    "Error creating iso fs"
[[ -n "${ERROR}" ]] && exit_error

SP_SIZE=$(du -b "${ISO_FILE}" | cut -f 1 || true)
SP_SIZE=$(( (SP_SIZE +511) /512 *512 ))
SP_VOL="${ONE_PX}-sys-${VM_ID}-${DISK_ID}"
SP_TEMPLATE="$(spVolumeTemplateName "${DS_ID}")"

if kvGetUid "${SP_VOL}"; then
    VOL_UID="${SP_UID}"
    storpoolVolumeResize "${VOL_UID}" "${SP_SIZE}" "shrinkOk"
else
    storpoolVolumeCreate "${SP_VOL}" "${SP_SIZE}" "${SP_TEMPLATE}" \
        "virt;${LOC_TAG};type;diskid;${VM_TAG}" \
        "one;${LOC_TAG_VAL};CNTXT;${DISK_ID};${VM_ID}"
    VOL_UID="${SP_UID}"
fi

SP_LINK="/dev/storpool-byid/${VOL_UID#*~}"

#-------------------------------------------------------------------------------
# Import image to the context volume
#-------------------------------------------------------------------------------

storpoolAttach "${VOL_UID}" "${DST_HOST}"
PIPE_CMD="cat ${ISO_FILE}"
splog "eval ${PIPE_CMD} | ${SSH:-ssh} ${DST_HOST} ${DD:-dd} of=${SP_LINK} bs=512k conv=fdatasync status=none iflag=fullblock oflag=direct"
exec_and_log "eval ${PIPE_CMD} | ${SSH:-ssh} ${DST_HOST} ${DD:-dd} of=${SP_LINK} bs=512k conv=fdatasync status=none iflag=fullblock oflag=direct" \
         "Error importing ${ISO_FILE} to ${DST_HOST}:${SP_LINK}"

#-------------------------------------------------------------------------------
# (re)attach readonly
#------------------------------------------------------------------------------
if [[ "${READONLY_MODE,,}" == "ro" ]]; then
    storpoolAttach "${VOL_UID}" "${DST_HOST}" "ro"
fi

if boolTrue "TAG_CONTEXT_ISO"; then
    storpoolVolumeTag "${VOL_UID}" \
        "virt;${LOC_TAG:-nloc};${VM_TAG:-nvm};${VC_POLICY:+vc-policy};${SP_QOSCLASS:+qc};type;diskid" \
        "one;${LOC_TAG_VAL};${VM_ID};${VC_POLICY};${SP_QOSCLASS};CNTXT;${DISK_ID}"

fi

MONITOR_TM_MAD=
if ! boolTrue "DS_SHARED"; then
    MONITOR_TM_MAD="storpool"
fi
export MONITOR_TM_MAD

oneSymlink "${DST_HOST}" "${VOL_UID}" "${DST_PATH}"

#-------------------------------------------------------------------------------
# Remove ISO file and source dir
#-------------------------------------------------------------------------------

rm -rf "${ISO_FILE}" > /dev/null 2>&1
rm -rf "${ISO_DIR}" > /dev/null 2>&1

if [[ -n ${T_OS_NVRAM} ]]; then
    NVRAM_TEMPLATE=""
    for _kv in ${T_OS_NVRAM#*:}; do
        # Only template= is required. Other attributes are ignored.
        # shellcheck disable=SC2249
        case "${_kv%%=*}" in
            template)
                NVRAM_TEMPLATE="${_kv#*=}"
                ;;
        esac
    done
    if [[ -z ${NVRAM_TEMPLATE} ]]; then
        ERROR="T_OS_NVRAM='${T_OS_NVRAM}' has no template= attribute"
        exit_error
    fi
    if [[ ${NVRAM_TEMPLATE#*/} == "${NVRAM_TEMPLATE}" ]]; then
        NVRAM_TEMPLATE="${OVMF_PATH:-/var/lib/one/remotes/OVMF}/${NVRAM_TEMPLATE}"
    fi
    if [[ ! -f ${NVRAM_TEMPLATE} ]]; then
        ERROR="NVRAM template ${NVRAM_TEMPLATE} not found (T_OS_NVRAM='${T_OS_NVRAM}')"
        exit_error
    fi
    SP_VOL="${ONE_PX}-sys-${VM_ID}-NVRAM"
    if storpoolVolumeExists "${SP_VOL}" byName; then
        VOL_UID="${SP_UID}"
        storpoolAttach "${VOL_UID}" "${DST_HOST}"
    else
        SIZE=$(stat --printf=%s "${NVRAM_TEMPLATE}")
        # QEMU maps the pflash at its exact size: not a multiple of 4KiB is
        # refused at start and a size other than the firmware's is silently
        # misread, so the volume gets exactly the size of the template file
        if [[ -z ${SIZE} ]] || [[ ${SIZE} -eq 0 ]] || [[ $((SIZE % 4096)) -ne 0 ]]; then
            ERROR="NVRAM template ${NVRAM_TEMPLATE} size '${SIZE}' is not a non-zero multiple of 4096"
            exit_error
        fi
        splog "NVRAM_TEMPLATE=${NVRAM_TEMPLATE} SIZE=${SIZE} //${T_OS_NVRAM}"
        storpoolVolumeCreate "${SP_VOL}" "${SIZE}" "${SP_TEMPLATE}" \
                "type;${VM_TAG};${VC_POLICY:+vc-policy};${SP_QOSCLASS:+qc}" \
                "NVRAM;${VM_ID};${VC_POLICY};${SP_QOSCLASS}"
        VOL_UID="${SP_UID}"
        if [[ -z ${VOL_UID} ]]; then
            ERROR="Error creating the NVRAM volume ${SP_VOL}"
            exit_error
        fi
        SP_LINK="/dev/storpool-byid/${VOL_UID#*~}"
        trapAdd "storpoolDelete \"${VOL_UID}\""
        storpoolAttach "${VOL_UID}" "${DST_HOST}"
        trapAdd "storpoolDetach \"${VOL_UID}\" \"force\" \"\" \"all\""
        PIPE_CMD="cat \"${NVRAM_TEMPLATE}\""
        splog "eval ${PIPE_CMD} | ${SSH:-ssh} ${DST_HOST} ${DD:-dd} of=${SP_LINK} bs=128k conv=fdatasync status=none iflag=fullblock oflag=direct"
        exec_and_log "eval ${PIPE_CMD} | ${SSH:-ssh} ${DST_HOST} ${DD:-dd} of=${SP_LINK} bs=128k conv=fdatasync status=none iflag=fullblock oflag=direct" \
            "Error importing ${NVRAM_TEMPLATE} to ${DST_HOST}:${SP_LINK}"
        trapReset
    fi
fi

if boolTrue "FORCE_DETACH_OTHER_CONTEXT"; then
    forceDetachOther "${VM_ID}" "${DST_HOST}"
fi

splog "END ${VM_ID}"
exit 0
