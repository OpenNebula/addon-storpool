DRIVER_PATH="$(dirname "$0")"
umask 077

# shellcheck source=/dev/null
source "${DRIVER_PATH}/../../scripts_common.sh"
#shellcheck source=tm/storpool/storpool_common.sh
source "${ONE_LOCATION:-/var/lib/one/remotes}/tm/storpool/storpool_common.sh"

function backupServiceVolumeDrop()
{
    [[ -n "${SVC_UID}" ]] || return 0
    DELAY_DELETE="" _SOFT_FAIL=1 storpoolDelete "${SVC_UID}" "force"
}

function backupServiceVolume()
{
    local _hdr="" _cmd="" _tpm_cmd="" _tar_size="" _size=0 _msg=""
    _hdr=$(cat <<EOF
    #
$(oneRemotesKvmrc)
    VTPM_SETUP="/usr/libexec/one/vtpm_setup"
    [[ -x "\${VTPM_SETUP}" ]] || VTPM_SETUP="\${REMOTES_DIR}/vtpm_setup"
EOF
)
    splog "[I] VM ${VM_ID} service volume ${SVC_VOL}: vm.xml${TPM_MODEL:+ + vTPM state}${NVRAM_PATH:+ + NVRAM ${NVRAM_PATH}}"
    ssh_forward ssh_exec_and_log "${KVMHOST}" "${REMOTE_HDR}
    mkdir -p \"${B_DISK_DIR}\"${REMOTE_FTR}" "Error creating ${B_DISK_DIR} on ${KVMHOST}"
    if ! signalWait "${RSYNC:-rsync}" -a "${B_LOCAL}/vm.xml" "${KVMHOST}:${B_DISK_DIR}/"; then
        _msg="Error copying ${B_LOCAL}/vm.xml to ${KVMHOST}:${B_DISK_DIR}"
        splog "[E] ${_msg}"
        error_message "${_msg}"
        exit 1
    fi
    if [[ -n "${TPM_MODEL}" ]] && [[ ${BACKUP_LIVE} -eq 1 ]]; then
        _tpm_cmd=$(cat <<EOF
    DOM_UUID="\$(virsh --connect "\${LIBVIRT_URI:-qemu:///system}" domuuid "one-${VM_ID}" | tr -d '\\n')"
    if sudo -l | grep -q vtpm_setup; then
        splog "VM ${VM_ID} Backing up vTPM data to ${VMDIR} DOM_UUID=\${DOM_UUID}"
        sudo "\${VTPM_SETUP}" backup "\${DOM_UUID}" "${VMDIR}"
    else
        splog "VM ${VM_ID} No sudo privileges to backup vTPM data to ${VMDIR} DOM_UUID=\${DOM_UUID}"
    fi
EOF
)
    fi
    _cmd=$(cat <<EOF
${_hdr}
${_tpm_cmd}
    members="vm.xml"
    rm -f "${B_DISK_DIR}/disk.tpm.0"
    rm -rf "${B_DISK_DIR}/nvram"
    if [[ -d "${VMDIR}/tpm" ]]; then
        tar zcf "${B_DISK_DIR}/disk.tpm.0" -C "${VMDIR}" tpm
        members+=" disk.tpm.0"
        splog "VM ${VM_ID} vTPM state packed to ${B_DISK_DIR}/disk.tpm.0"
    fi
    if [[ -n "${NVRAM_PATH}" ]]; then
        if [[ -f "${NVRAM_PATH}" ]]; then
            mkdir -p "${B_DISK_DIR}/nvram"
            cp -p "${NVRAM_PATH}" "${B_DISK_DIR}/nvram/"
            printf '%s\\n' "${NVRAM_PATH}" >"${B_DISK_DIR}/nvram/path"
            members+=" nvram"
            splog "VM ${VM_ID} NVRAM ${NVRAM_PATH} packed"
        else
            splog "VM ${VM_ID} NVRAM ${NVRAM_PATH} not found, not in the backup"
        fi
    fi
    tar cf "${B_DISK_DIR}/svc.tar" -C "${B_DISK_DIR}" \${members}
    splog "VM ${VM_ID} service tar of \${members} in ${B_DISK_DIR}/svc.tar"
EOF
)
    ssh_forward ssh_exec_and_log "${KVMHOST}" "${REMOTE_HDR}${_cmd}${REMOTE_FTR}" \
        "Error building the service tar of VM ${VM_ID} on ${KVMHOST}"
    _tar_size="$(ssh_forward ssh_monitor_and_log "${KVMHOST}" "stat -c %s \"${B_DISK_DIR}/svc.tar\"" "stat ${B_DISK_DIR}/svc.tar on ${KVMHOST}" | tr -d '[:space:]' || true)"
    if [[ -z "${_tar_size}" ]] || [[ -n "${_tar_size//[[:digit:]]/}" ]]; then
        _msg="Error reading the size of ${B_DISK_DIR}/svc.tar on ${KVMHOST} ('${_tar_size}')"
        splog "[E] ${_msg}"
        error_message "${_msg}"
        exit 1
    fi
    _size=$(( (_tar_size + 16 * 1048576 + 1048575) / 1048576 * 1048576 ))
    [[ ${_size} -ge $((32 * 1048576)) ]] || _size=$((32 * 1048576))
    storpoolVolumeCreate "${SVC_VOL}" "${_size}" "$(spVolumeTemplateName "${SYSDS_ID}")" "type;${VM_TAG}" "SVC;${VM_ID}"
    SVC_UID="${SP_UID}"
    if [[ -z "${SVC_UID}" ]]; then
        _msg="Error creating the service volume ${SVC_VOL} of VM ${VM_ID}"
        splog "[E] ${_msg}"
        error_message "${_msg}"
        exit 1
    fi
    trapAdd "backupServiceVolumeDrop"
    splog "[I] VM ${VM_ID} service volume ${SVC_UID} (${SVC_VOL}) ${_size} bytes for a ${_tar_size} bytes tar"
    storpoolAttach "${SVC_UID}" "${KVMHOST}"
    ssh_forward ssh_exec_and_log "${KVMHOST}" "${REMOTE_HDR}
    dd if=\"${B_DISK_DIR}/svc.tar\" of=\"/dev/storpool-byid/${SVC_UID#*~}\" bs=1M conv=fdatasync status=none${REMOTE_FTR}" \
        "Error writing ${B_DISK_DIR}/svc.tar to ${SVC_VOL} on ${KVMHOST}"
    storpoolDetach "${SVC_UID}" "force" "" "all"
    if ! signalWait "${RSYNC:-rsync}" -a "${KVMHOST}:${B_DISK_DIR}/svc.tar" "${B_LOCAL}/"; then
        _msg="Error copying ${KVMHOST}:${B_DISK_DIR}/svc.tar to ${B_LOCAL}"
        splog "[E] ${_msg}"
        error_message "${_msg}"
        exit 1
    fi
    ssh_forward ssh_exec_and_log "${KVMHOST}" "${REMOTE_HDR}
    rm -f \"${B_DISK_DIR}/disk.tpm.0\"
    rm -rf \"${B_DISK_DIR}/nvram\"${REMOTE_FTR}" "Error removing the service staging files of VM ${VM_ID} on ${KVMHOST}"
}

if [[ -t 0 ]]; then
    msg="Interactive mode not supported"
    splog "${msg}"
    error_message "${msg}"
    exit 1
fi

KVMHOST="${1%%:*}"
VMDIR="${1#*:}"
DISKS="$2"
DEPLOY_ID="$3"
VM_ID="$4"
SYSDS_ID="$5"
if [[ -n "$6" ]]; then
    BJ_ID="$4"
    VM_ID="$5"
    SYSDS_ID="$6"
fi
export BJ_ID  #  TBD: remove

# backup-cancel delivers TERM. Exit after the trap cleanup, and run the
# long copy steps under signalWait so that signal is not held until they end.
SP_EXIT_ON_SIGNAL=1
# datastore backup_cancel keeps processes named ruby, then matches this
# command line (the script path and the deploy id). The shebang name is bash.
if [[ -w /proc/self/comm ]]; then
    printf '%s' ruby > /proc/self/comm || true
fi

splog "${VM_ID} ${KVMHOST} ${VMDIR} DISKS='${DISKS}' ${DEPLOY_ID}${BJ_ID:+ JOB_ID=${BJ_ID}} SYSDS_ID=${SYSDS_ID}"

VM_XML="$(mktemp -t "prebackup-${VM_ID}-XXXXXXXX")"
trapAdd "rm -f \"${VM_XML}\""
cat > "${VM_XML}"

oneBackupTarget "${KVMHOST}" "${VMDIR}" "${VM_ID}" "${VM_XML}"

oneHostInfo "${KVMHOST}"

oneDatastoreInfo "${SYSDS_ID}"

oneVmVolumes "${VM_ID}" "" "${VM_XML}" "${DISKS}"

BACKUP_NATIVE=0
SP_BACKUP_MODE=""
if [[ -n "${BACKUP_DS_ID}" ]]; then
    oneBackupDsInfo "${BACKUP_DS_ID}"
    if [[ "${BACKUP_DS_MAD}" == "storpool" ]]; then
        BACKUP_NATIVE=1
        SP_BACKUP_MODE="$(oneBackupModeName)"
        splog "[I] VM ${VM_ID} ${SP_BACKUP_MODE} backup to the StorPool backup datastore ${BACKUP_DS_ID}${SP_BACKUP_LOCATION:+ (${SP_BACKUP_LOCATION})}"
    fi
fi
# oned runs this file as prebackup_live only while the guest is up.
# A POWEROFF backup has no domain, so FS_FREEZE is not applied.
BACKUP_LIVE=0
if [[ "${0##*/}" == "prebackup_live" ]]; then
    BACKUP_LIVE=1
fi

if [[ ${BACKUP_INTERACTIVE} -eq 1 ]] && [[ "${BACKUP_MODE^^}" == "INCREMENT" ]]; then
    msg="Backup of VM ${VM_ID}: only full interactive backups are supported on StorPool (MODE=${BACKUP_MODE})"
    splog "${msg}"
    error_message "${msg}"
    exit 1
fi

SNAPSHOTS_LIST="${B_LOCAL}/.storpool_snapshots"

if [[ -d "${B_LOCAL}" ]]; then
    splog "[I] pre-clean ${B_LOCAL} ..."
    rm -rf "${B_LOCAL}"
    splog "[I] pre-clean completed ($?)"
fi
# oned runs one backup of a VM at a time: every file-based backup snapshot (bak) of the VM
# is a leftover, and so is a native one (bkp) whose epoch is in no backup image SOURCE.
# A remote-mode leftover (a transient export, or copies on the target) is dropped only
# when its KV family names the target; otherwise it is left for kvchk, since unexporting
# the transient would let the copy complete with nothing pointing at it.
REGISTERED_EPOCHS=" "
while read -r rEpoch _; do
    [[ -n "${rEpoch}" ]] || continue
    REGISTERED_EPOCHS+="${rEpoch} "
done < <(oneBackupRegistered "${VM_ID}")
declare -A kvMode kvLoc kvIds kvDropFailed
while read -r kEpoch kDid kVal; do
    [[ -n "${kEpoch}" ]] || continue
    [[ "${REGISTERED_EPOCHS}" != *" ${kEpoch} "* ]] || continue
    if [[ "${kDid}" == "-" ]]; then
        kvMode["${kEpoch}"]="$(oneBackupKvField "${kVal}" mode)"
        kvLoc["${kEpoch}"]="$(oneBackupKvField "${kVal}" loc)"
    else
        kvIds["${kEpoch}"]+="${kVal#\~} "
    fi
done < <(oneBackupKvFamily "${VM_ID}")
if DO_MULTICLUSTER=1 DO_ALLCLUSTERS=1 DO_REMOTE="" storpoolRetry SnapshotsList >/dev/null; then
    while read -r -u "${spfh}" sName sBak sBkp sGid sTransient; do
        if [[ "${sBkp}" != "-" ]]; then
            [[ "${REGISTERED_EPOCHS}" != *" ${sBkp} "* ]] || continue
            if [[ "${sTransient}" == "true" ]]; then
                sLoc="${kvLoc[${sBkp}]:--}"
                if [[ "${sLoc}" == "-" ]]; then
                    splog "[W] VM ${VM_ID} leftover backup export ${sName} (~${sGid}, epoch ${sBkp}) has no KV record of its target, kept for kvchk"
                    continue
                fi
                splog "[I] Removing the leftover backup export ${sName} (~${sGid}, epoch ${sBkp}) and its copy on ${sLoc}"
                sLocName="$(storpoolRemoteCopies "${sGid}" | awk '{print $2}' | head -n 1 || true)"
                SP_BACKUP_LOCATION="${sLoc}" storpoolBackupCopyDrop "${sGid}" "${sLocName:-${sLoc}}" || kvDropFailed["${sBkp}"]=1
                storpoolBackupSnapshotDrop "${sGid}" || kvDropFailed["${sBkp}"]=1
                continue
            fi
            splog "[I] Removing the leftover backup snapshot ${sName} (~${sGid}, epoch ${sBkp})"
            storpoolBackupSnapshotDrop "${sGid}" || kvDropFailed["${sBkp}"]=1
            continue
        fi
        splog "[I] Removing the leftover backup snapshot ${sName} (${sBak})"
        json="{\"snapshot\":\"${sName}\",\"detach\":\"all\",\"force\":true}"
        DO_MULTICLUSTER=1 DO_REMOTE="" storpoolRetry VolumesReassignWait "\"reassign\":[${json}]"
        SKIP_KV_DATA=1 storpoolSnapshotDelete "${sName}"
    done {spfh}< <(jq -r --arg vmtag "${VM_TAG}" --arg vmid "${VM_ID}" --arg loctag "${LOC_TAG}" --arg locval "${LOC_TAG_VAL}" \
        '(if (.data|type)=="array" then .data[] else .data.clusters[].response.data[]? end)
         | select(.deleted==false and .tags.virt=="one" and (.tags[$loctag] // $locval)==$locval and .tags[$vmtag]==$vmid and ((.tags.bak // "")!="" or (.tags.bkp // "")!="") and .tags.snap==null)
         | "\(.name) \(.tags.bak // "-") \(.tags.bkp // "-") \(.globalId) \(.transient)"' "${TMPDIR}/SnapshotsList.json" || true)
    exec {spfh}<&-
else
    splog "[W] SnapshotsList failed ($?), leftover backup snapshots of VM ${VM_ID} are not cleaned"
fi
for kEpoch in "${!kvMode[@]}"; do
    case "${kvMode[${kEpoch}]}" in
        local)
            ;;
        remote)
            kLoc="${kvLoc[${kEpoch}]:--}"
            if [[ "${kLoc}" == "-" ]]; then
                splog "[W] VM ${VM_ID} epoch ${kEpoch} has no backup image and no target in its KV records, kept for kvchk"
                continue
            fi
            for kId in ${kvIds[${kEpoch}]:-}; do
                kLocName="$(storpoolRemoteCopies "${kId}" | awk '{print $2}' | head -n 1 || true)"
                SP_BACKUP_LOCATION="${kLoc}" storpoolBackupCopyDrop "${kId}" "${kLocName:-${kLoc}}" || kvDropFailed["${kEpoch}"]=1
            done
            ;;
        *)
            splog "[W] VM ${VM_ID} epoch ${kEpoch} KV record without a mode, kept for kvchk"
            continue
            ;;
    esac
    if [[ -n "${kvDropFailed[${kEpoch}]:-}" ]]; then
        splog "[W] VM ${VM_ID} epoch ${kEpoch} has no backup image and not every leftover was dropped, its KV records are kept for kvchk"
    else
        splog "[I] Removing the KV backup index of VM ${VM_ID} epoch ${kEpoch} (no backup image)"
        oneBackupKvDel "${VM_ID}" "${kEpoch}"
    fi
done
oneBackupRemoveDir "${KVMHOST}" "${B_DISK_DIR}"
if [[ "${B_HOST}:${B_DIR}" != "${KVMHOST}:${B_DISK_DIR}" ]]; then
    oneBackupRemoveDir "${B_HOST}" "${B_DIR}"
fi

mkdir -p "${B_LOCAL}"
splog "mkdir -p ${B_LOCAL}"

base64 -w 60 "${VM_XML}" >"${B_LOCAL}/vm.xml"
splog "base64 ${VM_XML} to ${B_LOCAL}/vm.xml ($?)"

NVRAM_PATH=""
if [[ ${BACKUP_NATIVE} -eq 1 ]]; then
    NVRAM_PATH="$(oneBackupNvramPath "${VM_XML}" "${VMDIR}")"
fi

rm -f "${VM_XML}"
trapDel "rm -f \"${VM_XML}\""

# DISKS is the backup set. oned includes volatile disks when
# BACKUP_VOLATILE is set, then drops any disk absent from DISK_IDS.
declare -A D_ARR
for disk in ${DISKS//:/ }; do
    D_ARR["${disk}"]="${disk}"
done

otherDisks=""
for disk in ${vmOtherDisks}; do
    if [[ -n "${D_ARR["${disk##*.}"]}" ]]; then
        otherDisks+="${disk} "
    fi
done
if [[ -n "${otherDisks}" ]]; then
    if [[ ${BACKUP_INTERACTIVE} -eq 0 ]] && [[ ${BACKUP_NATIVE} -eq 0 ]] && boolTrue "BACKUP_SKIP_OTHER_DISKS"; then
        splog "[W] VM ${VM_ID} backup skips the non-StorPool disks (${otherDisks% })"
    else
        msg="Backup of a VM with non-StorPool disks is not supported! (${otherDisks% })"
        splog "${msg}"
        error_message "${msg}"
        exit 1
    fi
fi

B_SUFFIX="ONEBACKUP-$(date +%s || true)"
if [[ ${BACKUP_NATIVE} -eq 1 ]]; then
    B_EPOCH="${B_SUFFIX#ONEBACKUP-}"
    SVC_VOL="${ONE_PX}-sys-${VM_ID}-SVC-${B_EPOCH}"
    SVC_UID=""
    # vm.xml is in the service tar for every StorPool backup. vTPM state and a
    # file NVRAM are added when the VM has them.
    backupServiceVolume
    json_volumes=""
    group_uids=""
    declare -A didByUid
    for map in ${vmDisksMap}; do
        img="${map%:*}"
        did="${map#*:}"
        [[ -n "${did}" ]] || continue
        [[ -n "${D_ARR["${did}"]}" ]] || continue
        kvGetUid "${img}" fatal
        tags=$(tagsHelper "${VM_TAG};${LOC_TAG};virt;img;diskid;bkp" "${VM_ID};${LOC_TAG_VAL};one;${img};${did};${B_EPOCH}")
        json_volumes+="${json_volumes:+,}{\"volume\":\"${SP_UID}\",\"tags\":{${tags}},\"name\":\"\"}"
        group_uids+="${group_uids:+,}\"${SP_UID}\""
        didByUid["${SP_UID}"]="${did}"
    done
    if [[ -n "${T_OS_NVRAM}" ]]; then
        img="${ONE_PX}-sys-${VM_ID}-NVRAM"
        kvGetUid "${img}" fatal
        tags=$(tagsHelper "${VM_TAG};${LOC_TAG};virt;img;diskid;bkp" "${VM_ID};${LOC_TAG_VAL};one;${img};nvram;${B_EPOCH}")
        json_volumes+="${json_volumes:+,}{\"volume\":\"${SP_UID}\",\"tags\":{${tags}},\"name\":\"\"}"
        group_uids+="${group_uids:+,}\"${SP_UID}\""
        didByUid["${SP_UID}"]="nvram"
    fi
    if [[ -n "${SVC_UID}" ]]; then
        tags=$(tagsHelper "${VM_TAG};${LOC_TAG};virt;img;diskid;bkp" "${VM_ID};${LOC_TAG_VAL};one;${SVC_VOL};svc;${B_EPOCH}")
        json_volumes+="${json_volumes:+,}{\"volume\":\"${SVC_UID}\",\"tags\":{${tags}},\"name\":\"\"}"
        group_uids+="${group_uids:+,}\"${SVC_UID}\""
        didByUid["${SVC_UID}"]="svc"
    fi
    if [[ -z "${json_volumes}" ]]; then
        msg="VM ${VM_ID} has no StorPool disk to back up (DISKS='${DISKS}')"
        splog "[E] ${msg}"
        error_message "${msg}"
        exit 1
    fi
    if [[ ${BACKUP_LIVE} -eq 1 ]]; then
        oneBackupConsistencyBegin "${KVMHOST}" "${DEPLOY_ID}" "${BACKUP_FS_FREEZE-}"
    fi
    if [[ "${SP_BACKUP_MODE}" == "remote" ]]; then
        tags=$(tagsHelper "bkp;${VM_TAG};${LOC_TAG};virt" "${B_EPOCH};${VM_ID};${LOC_TAG_VAL};one")
        DO_MULTICLUSTER=1 DO_REMOTE="" storpoolRetry VolumesGroupBackup \
            "\"volumes\":[${group_uids}],\"location\":\"${SP_BACKUP_LOCATION}\",\"tags\":{${tags}}" >/dev/null
        ret=$?
        group_json="${TMPDIR}/VolumesGroupBackup.json"
    else
        DO_MULTICLUSTER=1 DO_REMOTE="" storpoolRetry VolumesGroupSnapshot "\"volumes\":[${json_volumes}]" >/dev/null
        ret=$?
        group_json="${TMPDIR}/VolumesGroupSnapshot.json"
    fi
    if [[ ${BACKUP_LIVE} -eq 1 ]]; then
        oneBackupConsistencyEnd "${KVMHOST}" "${DEPLOY_ID}"
    fi
    if [[ ${ret} -ne 0 ]]; then
        msg="Error creating the ${SP_BACKUP_MODE} backup snapshots of VM ${VM_ID} (${ret})"
        splog "[E] ${msg}"
        error_message "${msg}"
        exit 1
    fi
    entries=""
    if [[ "${SP_BACKUP_MODE}" == "remote" ]]; then
        while read -r -u "${xfh}" uid rid; do
            [[ -n "${uid}" && -n "${didByUid[${uid}]:-}" ]] || continue
            entries+="${didByUid[${uid}]}=~${rid} "
        done {xfh}< <(jq -r '.data.backups|to_entries[]|"\(.key) \(.value.remoteId)"' "${group_json}" || true)
    else
        while read -r -u "${xfh}" uid gid; do
            [[ -n "${uid}" && -n "${didByUid[${uid}]:-}" ]] || continue
            entries+="${didByUid[${uid}]}=~${gid} "
        done {xfh}< <(jq -r '.data.snapshots[]|"\(.volume) \(.snapshotGlobalId)"' "${group_json}" || true)
    fi
    exec {xfh}<&-
    if [[ $(wc -w <<< "${entries}") -ne ${#didByUid[*]} ]]; then
        msg="VM ${VM_ID} ${SP_BACKUP_MODE} backup epoch ${B_EPOCH}: ${#didByUid[*]} volumes sent, snapshots of '${entries}' returned"
        splog "[E] ${msg}"
        error_message "${msg}"
        exit 1
    fi
    oneBackupKvPut "${VM_ID}" "${B_EPOCH}" "${SP_BACKUP_MODE}" "${SVC_UID:--}" "${entries}"
    splog "[I] VM ${VM_ID} ${SP_BACKUP_MODE} backup epoch ${B_EPOCH}$(oneBackupIncrementNote)${SP_BACKUP_LOCATION:+ to ${SP_BACKUP_LOCATION}}: ${entries}"
    if [[ -n "${SVC_UID}" ]]; then
        trapDel "backupServiceVolumeDrop"
        if backupServiceVolumeDrop; then
            SVC_UID=""
        else
            splog "[W] VM ${VM_ID} service volume ${SVC_UID} (${SVC_VOL}) not deleted ($?), the backup datastore action retries"
        fi
    fi
    splog "END ${VM_ID} (StorPool backup datastore ${BACKUP_DS_ID})"
    exit 0
fi
echo "${B_SUFFIX}" >"${B_LOCAL}/.snapshot_suffix"
declare -a list_a
backups=

json_volumes=""
for map in ${vmDisksMap}; do
    img="${map%:*}"
    did="${map#*:}"
    if [[ -z "${did}" ]]; then
        # system volume without a DISK_ID (UEFI NVRAM): not part of the backup,
        # like the nvram file of upstream OpenNebula
        continue
    fi
    kvGetUid "${img}" fatal
    if [[ -n "${D_ARR["${did}"]}" ]]; then
        tags=$(tagsHelper "${VM_TAG};${LOC_TAG};virt;img;bak" "${VM_ID};${LOC_TAG_VAL};one;${img};${B_SUFFIX}")
        json_volumes+="${json_volumes:+,}{\"volume\":\"${SP_UID}\",\"tags\":{${tags}},\"name\":\"\"}"
        snapshot="${img}-${B_SUFFIX}"
        list_a+=("${SP_UID}" "${snapshot}")
        backups+="${SP_UID}:${snapshot}:${did} "
    fi
done
json="\"volumes\":[${json_volumes}]"
if [[ ${BACKUP_LIVE} -eq 1 ]]; then
    oneBackupConsistencyBegin "${KVMHOST}" "${DEPLOY_ID}" "${BACKUP_FS_FREEZE-}"
fi
DO_MULTICLUSTER=1 DO_REMOTE="" storpoolRetry VolumesGroupSnapshot "${json}" >/dev/null
ret=$?
if [[ ${BACKUP_LIVE} -eq 1 ]]; then
    oneBackupConsistencyEnd "${KVMHOST}" "${DEPLOY_ID}"
fi
if [[ ${ret} -ne 0 ]]; then
    splog "Error: Can't create volumes group snapshots (${ret})"
    exit 1
fi
while read -r -u "${xfh}" volume snapshotGlobalId snapshotName; do
    echo "${volume} ${snapshotGlobalId} ${snapshotName}" >>"${SNAPSHOTS_LIST}"
done {xfh}< <(jq -r '.data.snapshots[]|"\(.volume) \(.snapshotGlobalId) \(.snapshotName)"' "${TMPDIR}/VolumesGroupSnapshot.json" || true)
exec {xfh}<&-

if [[ -n "${TPM_MODEL}" ]]; then
    if [[ ${BACKUP_INTERACTIVE} -eq 1 ]]; then
        splog "[W] VM ${VM_ID} vTPM state is not part of an interactive backup"
    else
        oneTpmBackup "${VM_ID}" "${VMDIR}" "${KVMHOST}" "${B_DISK_DIR}"
    fi
fi

for bak in ${backups}; do
    IFS=: read -r volume snapshot did <<< "${bak}"
    read -r vName sGlobalId sName <<< "$(grep "${volume} " "${SNAPSHOTS_LIST}" || true)"
    if boolTrue "DEBUG_BACKUP"; then
        splog "[D] did=${did} volume=${volume} snapshot=${snapshot} vName=${vName} sGlobalId=${sGlobalId} sName=${sName}"
    fi
    json="{\"snapshot\":\"${sName}\",\"ro\":[${HOST_SP_OURID}]}"
    DO_MULTICLUSTER=1 DO_REMOTE="~${HOST_SP_CLUSTER_ID:-${SP_CLUSTER_ID}}" storpoolRetry VolumesReassignWait "\"reassign\":[${json}]"
    ret=$?
    if [[ ${ret} -ne 0 ]]; then
        splog "[E] Error: Can't attach ${sName} to ${KVMHOST}"
        exit 1
    fi
    if [[ ${BACKUP_INTERACTIVE} -eq 1 ]]; then
        continue
    fi
    snapPath="/dev/storpool-byid/${sGlobalId}"
    dstFile="${B_DISK_DIR}/disk.${did}.0"
    RCMD=$(cat <<EOF
umask 077
mkdir -p "${B_DISK_DIR}"
${QEMU_IMG:-qemu-img} convert -f raw -T none -t none -O qcow2 "${snapPath}" "${dstFile}"
EOF
)
    splog "[I] RCMD ${KVMHOST}::$(echo "${RCMD}" | tr '\n' ';' || true)"
    signalWait ssh_forward ssh_exec_and_log "${KVMHOST}" "${RCMD}" "Error extracting ${RCMD} on ${KVMHOST}" || exit $?
    json="{\"snapshot\":\"${sName}\",\"detach\":\"all\",\"force\":true}"
    DO_MULTICLUSTER=1 DO_REMOTE="" storpoolRetry VolumesReassignWait "\"reassign\":[${json}]"
done

if [[ ${BACKUP_INTERACTIVE} -eq 1 ]]; then
    oneBackupExports "${KVMHOST}" "${B_DIR}" "${SNAPSHOTS_LIST}" "${backups}" || exit $?
fi

oneBackupPublish "${KVMHOST}" || exit $?
splog "[I] backup published to ${B_HOST}:${B_DIR}"

if [[ ${BACKUP_INTERACTIVE} -eq 1 ]]; then
    splog "[I] exporting VM ${VM_ID} disks through OneBEX on ${KVMHOST}, waiting for the backup application"
    signalWait oneBackupOneBEX "${KVMHOST}" "${VM_ID}" "${SYSDS_ID}" "${B_DIR}" || exit $?
    splog "[I] OneBEX export of VM ${VM_ID} completed"
fi

splog "END ${VM_ID}"
