DRIVER_PATH="$(dirname "$0")"
umask 077

# shellcheck source=/dev/null
source "${DRIVER_PATH}/../../scripts_common.sh"
#shellcheck source=tm/storpool/storpool_common.sh
source "${ONE_LOCATION:-/var/lib/one/remotes}/tm/storpool/storpool_common.sh"

if [[ -t 0 ]]; then
    msg="Interactive mode not supported"
    splog "${msg}"
    error_message "${msg}"
    exit 1
fi

KVMHOST="${1%%:*}"
VMDIR="${1#*:}"
DISKS="$2"
DEPLOY_ID="$3"
VM_ID="$4"
SYSDS_ID="$5"
if [[ -n "$6" ]]; then
    BJ_ID="$4"
    VM_ID="$5"
    SYSDS_ID="$6"
fi
export BJ_ID  #  TBD: remove

# backup-cancel delivers TERM. Exit after the trap cleanup, and run the
# long copy steps under signalWait so that signal is not held until they end.
SP_EXIT_ON_SIGNAL=1
# datastore backup_cancel keeps processes named ruby, then matches this
# command line (the script path and the deploy id). The shebang name is bash.
if [[ -w /proc/self/comm ]]; then
    printf '%s' ruby > /proc/self/comm || true
fi

splog "${VM_ID} ${KVMHOST} ${VMDIR} DISKS='${DISKS}' ${DEPLOY_ID}${BJ_ID:+ JOB_ID=${BJ_ID}} SYSDS_ID=${SYSDS_ID}"

VM_XML="$(mktemp -t "prebackup-${VM_ID}-XXXXXXXX")"
trapAdd "rm -f \"${VM_XML}\""
cat > "${VM_XML}"

oneBackupTarget "${KVMHOST}" "${VMDIR}" "${VM_ID}" "${VM_XML}"

oneHostInfo "${KVMHOST}"

oneDatastoreInfo "${SYSDS_ID}"

oneVmVolumes "${VM_ID}" "" "${VM_XML}" "${DISKS}"

SNAPSHOTS_LIST="${B_LOCAL}/.storpool_snapshots"

if [[ -d "${B_LOCAL}" ]]; then
    splog "[I] pre-clean ${B_LOCAL} ..."
    if [[ -f "${SNAPSHOTS_LIST}" ]]; then
        while read -r -u "${spfh}" volume sGlobalId sName; do
            splog "[I] Removing snapshot ${sName}, volume ${volume}"
            json="{\"snapshot\":\"${sName}\",\"detach\":\"all\",\"force\":true}"
            DO_MULTICLUSTER=1 DO_REMOTE="" storpoolRetry VolumesReassignWait "\"reassign\":[${json}]"
            SKIP_KV_DATA=1 storpoolSnapshotDelete "${sName}"
        done {spfh}< <(cat "${SNAPSHOTS_LIST}" || true)
        exec {spfh}<&-
    fi
    rm -rf "${B_LOCAL}"
    splog "[I] pre-clean completed ($?)"
fi
oneBackupRemoveDir "${KVMHOST}" "${B_DISK_DIR}"
if [[ "${B_HOST}:${B_DIR}" != "${KVMHOST}:${B_DISK_DIR}" ]]; then
    oneBackupRemoveDir "${B_HOST}" "${B_DIR}"
fi

mkdir -p "${B_LOCAL}"
splog "mkdir -p ${B_LOCAL}"

base64 -w 60 "${VM_XML}" >"${B_LOCAL}/vm.xml"
splog "base64 ${VM_XML} to ${B_LOCAL}/vm.xml ($?)"

rm -f "${VM_XML}"
trapDel "rm -f \"${VM_XML}\""

# DISKS is the backup set. oned includes volatile disks when
# BACKUP_VOLATILE is set, then drops any disk absent from DISK_IDS.
declare -A D_ARR
for disk in ${DISKS//:/ }; do
    D_ARR["${disk}"]="${disk}"
done

otherDisks=""
for disk in ${vmOtherDisks}; do
    if [[ -n "${D_ARR["${disk##*.}"]}" ]]; then
        otherDisks+="${disk} "
    fi
done
if [[ -n "${otherDisks}" ]]; then
    if boolTrue "BACKUP_SKIP_OTHER_DISKS"; then
        splog "[W] VM ${VM_ID} backup skips the non-StorPool disks (${otherDisks% })"
    else
        msg="Backup of a VM with non-StorPool disks is not supported! (${otherDisks% })"
        splog "${msg}"
        error_message "${msg}"
        exit 1
    fi
fi

B_SUFFIX="ONEBACKUP-$(date +%s || true)"
echo "${B_SUFFIX}" >"${B_LOCAL}/.snapshot_suffix"
declare -a list_a
backups=

json_volumes=""
for map in ${vmDisksMap}; do
    img="${map%:*}"
    did="${map#*:}"
    if [[ -z "${did}" ]]; then
        # system volume without a DISK_ID (UEFI NVRAM): not part of the backup,
        # like the nvram file of upstream OpenNebula
        continue
    fi
    kvGetUid "${img}" fatal
    if [[ -n "${D_ARR["${did}"]}" ]]; then
        tags=$(tagsHelper "${VM_TAG};${LOC_TAG};virt;img;bak" "${VM_ID};${LOC_TAG_VAL};one;${img};${B_SUFFIX}")
        json_volumes+="${json_volumes:+,}{\"volume\":\"${SP_UID}\",\"tags\":{${tags}},\"name\":\"\"}"
        snapshot="${img}-${B_SUFFIX}"
        list_a+=("${SP_UID}" "${snapshot}")
        backups+="${SP_UID}:${snapshot}:${did} "
    fi
done
json="\"volumes\":[${json_volumes}]"
# oned runs this file as prebackup_live only while the guest is up.
# A POWEROFF backup has no domain, so FS_FREEZE is not applied.
BACKUP_LIVE=0
if [[ "${0##*/}" == "prebackup_live" ]]; then
    BACKUP_LIVE=1
fi
if [[ ${BACKUP_LIVE} -eq 1 ]]; then
    oneBackupConsistencyBegin "${KVMHOST}" "${DEPLOY_ID}" "${BACKUP_FS_FREEZE-}"
fi
DO_MULTICLUSTER=1 DO_REMOTE="" storpoolRetry VolumesGroupSnapshot "${json}" >/dev/null
ret=$?
if [[ ${BACKUP_LIVE} -eq 1 ]]; then
    oneBackupConsistencyEnd "${KVMHOST}" "${DEPLOY_ID}"
fi
if [[ ${ret} -ne 0 ]]; then
    splog "Error: Can't create volumes group snapshots (${ret})"
    exit 1
fi
while read -r -u "${xfh}" volume snapshotGlobalId snapshotName; do
    echo "${volume} ${snapshotGlobalId} ${snapshotName}" >>"${SNAPSHOTS_LIST}"
done {xfh}< <(jq -r '.data.snapshots[]|"\(.volume) \(.snapshotGlobalId) \(.snapshotName)"' "${TMPDIR}/VolumesGroupSnapshot.json" || true)
exec {xfh}<&-

if [[ -n "${TPM_MODEL}" ]]; then
    oneTpmBackup "${VM_ID}" "${VMDIR}" "${KVMHOST}" "${B_DISK_DIR}"
fi

for bak in ${backups}; do
    IFS=: read -r volume snapshot did <<< "${bak}"
    read -r vName sGlobalId sName <<< "$(grep "${volume} " "${SNAPSHOTS_LIST}" || true)"
    if boolTrue "DEBUG_BACKUP"; then
        splog "[D] did=${did} volume=${volume} snapshot=${snapshot} vName=${vName} sGlobalId=${sGlobalId} sName=${sName}"
    fi
    json="{\"snapshot\":\"${sName}\",\"ro\":[${HOST_SP_OURID}]}"
    DO_MULTICLUSTER=1 DO_REMOTE="~${HOST_SP_CLUSTER_ID:-${SP_CLUSTER_ID}}" storpoolRetry VolumesReassignWait "\"reassign\":[${json}]"
    ret=$?
    if [[ ${ret} -ne 0 ]]; then
        splog "[E] Error: Can't attach ${sName} to ${KVMHOST}"
        exit 1
    fi
    snapPath="/dev/storpool-byid/${sGlobalId}"
    dstFile="${B_DISK_DIR}/disk.${did}.0"
    RCMD=$(cat <<EOF
umask 077
mkdir -p "${B_DISK_DIR}"
${QEMU_IMG:-qemu-img} convert -f raw -T none -t none -O qcow2 "${snapPath}" "${dstFile}"
EOF
)
    splog "[I] RCMD ${KVMHOST}::$(echo "${RCMD}" | tr '\n' ';' || true)"
    signalWait ssh_forward ssh_exec_and_log "${KVMHOST}" "${RCMD}" "Error extracting ${RCMD} on ${KVMHOST}" || exit $?
    json="{\"snapshot\":\"${sName}\",\"detach\":\"all\",\"force\":true}"
    DO_MULTICLUSTER=1 DO_REMOTE="" storpoolRetry VolumesReassignWait "\"reassign\":[${json}]"
done

oneBackupPublish "${KVMHOST}" || exit $?
splog "[I] backup published to ${B_HOST}:${B_DIR}"

splog "END ${VM_ID}"
