DRIVER_PATH="$(dirname "$0")"

# shellcheck source=/dev/null
source "${DRIVER_PATH}/../../scripts_common.sh"
# shellcheck source=tm/storpool/storpool_common.sh
source "${DRIVER_PATH}/../../tm/storpool/storpool_common.sh"

# returns on error (multiline_exec_and_log exits), so the rollback runs
function restoreCopyToLink()
{
    local _LINK="$1"
    local _PIPE="" _ERR="" _RET=0
    _PIPE="set -e -o pipefail; eval ${COPY_CMD//&/\\&} | ${SSH:-ssh} ${DST_HOST} ${DD:-dd} of=${_LINK} bs=\"${COPY_CMD_DD_BS:-1M}\" status=none iflag=fullblock oflag=direct"
    splog "${_PIPE}"
    _ERR=$(bash -c "${_PIPE}" 2>&1 1>/dev/null)
    _RET=$?
    if [[ ${_RET} -ne 0 ]]; then
        splog "[E] Error restoring ${BACKUP_URL} to ${DST_HOST}:${_LINK} (${_RET}) ${_ERR}"
        error_message "Error restoring ${BACKUP_URL} to ${DST_HOST}:${_LINK}"
    fi
    return "${_RET}"
}

function restoreRollbackDelete()
{
    local _did="$1"
    local _ing="${disksIngressUid_a[${_did}]:-}"
    local _new="${disksNewUid_a[${_did}]:-}"
    if [[ -n "${_ing}" ]]; then
        DELAY_DELETE="" _SOFT_FAIL=1 storpoolDelete "${_ing}" "force"
    fi
    if [[ -n "${_new}" ]]; then
        DELAY_DELETE="" _SOFT_FAIL=1 storpoolDelete "${_new}" "force"
    fi
}

function restoreRollbackRename()
{
    local _did="$1"
    local _old="${disksOldUid_a[${_did}]:-}"
    local _vol="${disksMap_a[${_did}]}"
    [[ -n "${_old}" ]] || return 0
    _SOFT_FAIL=1 storpoolVolumeRename "${_old}" "${_vol}-${_TMP_NAME}" "${_vol}"
}

function restoreCommitCleanup()
{
    local _did _old
    for _did in "${!disksCommitted_a[@]}"; do
        _old="${disksOldUid_a[${_did}]:-}"
        [[ -n "${_old}" ]] || continue
        DELAY_DELETE="" _SOFT_FAIL=1 storpoolDelete "${_old}" "force" "" "" "\"reason\":\"tm_restore\""
    done
}

function restoreDropForgottenSnapshots()
{
    local _vol _type _prefix
    for _vol in ${vmVolumes}; do
        [[ -n "${_vol}" ]] || continue
        _type="${diskTypeMap_a[${_vol}]:-}"
        _prefix="${VMSNAPSHOT_TAG}"
        case "${_type}" in
            NPERS*) _prefix+=",snap" ;;
        esac
        splog "[I] VM ${VM_ID} restore drop ${_prefix} of ${_vol}"
        _SOFT_FAIL=1 storpoolSnapshotsDelete "${_vol}" "${_prefix}"
    done
    if [[ -n "${TPM_MODEL}" ]]; then
        _vol="${ONE_PX}-sys-${VM_ID}-SWTPM"
        splog "[I] VM ${VM_ID} restore drop ${VMSNAPSHOT_TAG} of ${_vol}"
        _SOFT_FAIL=1 storpoolSnapshotsDelete "${_vol}" "${VMSNAPSHOT_TAG}"
    fi
}

function restoreVolumeFromSnapshot()
{
    local _did="$1" _url="$2"
    local _vol="" _tmp_name="" _snap_uid="" _template="" _xtype="" _tag_k="" _tag_v="" _ret=0
    if [[ "${_did}" == "nvram" ]]; then
        _vol="${ONE_PX}-sys-${VM_ID}-NVRAM"
        disksMap_a["${_did}"]="${_vol}"
        diskTypeMap_a["${_vol}"]="NVRAM"
    else
        _vol="${disksMap_a[${_did}]}"
    fi
    _tmp_name="${_vol}-${_TMP_NAME}"
    kvGetUid "${_vol}" fatal
    storpoolVolumeInfo "${SP_UID:?}"
    if [[ -z "${V_SIZE}" ]]; then
        splog "[E] VM ${VM_ID} volume ${SP_UID} (${_vol}) not found"
        error_message "volume ${_vol} not found"
        exit 1
    fi
    VOL_UID="${SP_UID}"
    if [[ "${_did}" == "nvram" ]]; then
        _template="$(spVolumeTemplateName "${VM_DS_ID}")"
    else
        _template="${V_TEMPLATE_NAME}"
    fi
    if ! oneSnapshotLookup "${_url}"; then
        error_message "Can't resolve the backup URL ${_url} of disk ${_did}"
        exit 1
    fi
    if [[ -n "${REMOTE_ID}" ]]; then
        _template="$(spBackupPullTemplate "${_template}")"
        if ! storpoolSnapshotPullRemote "${_vol}-pull-${_TMP_NAME}" "${REMOTE_ID}" "${REMOTE_LOCATION}" "${_template}" \
                "img;${LOC_TAG};virt;${VM_TAG}" "${_vol}-pull-${_TMP_NAME};${LOC_TAG_VAL};one;${VM_ID}"; then
            error_message "Error pulling the backup ${REMOTE_ID} of disk ${_did} from ${REMOTE_LOCATION}"
            exit 1
        fi
        _snap_uid="${SP_UID}"
        disksIngressUid_a["${_did}"]="${_snap_uid}"
        trapAdd "restoreRollbackDelete '${_did}'"
    else
        _snap_uid="${SNAPSHOT_NAME}"
    fi
    if ! storpoolSnapshotInfo "${_snap_uid}"; then
        splog "[E] VM ${VM_ID} disk.${_did} backup snapshot ${_snap_uid} not found"
        error_message "backup snapshot ${_snap_uid} of disk ${_did} not found"
        exit 1
    fi
    if [[ ${X_SIZE} -gt ${V_SIZE} ]]; then
        splog "[E] VM ${VM_ID} disk.${_did} backup snapshot size ${X_SIZE} > volume ${V_SIZE}"
        error_message "backup snapshot size ${X_SIZE} > volume ${V_SIZE} of disk ${_did}"
        exit 1
    elif [[ ${X_SIZE} -lt ${V_SIZE} ]]; then
        splog "[W] VM ${VM_ID} disk.${_did} backup snapshot size ${X_SIZE} < volume ${V_SIZE}"
    fi
    splog "VM ${VM_ID} restoring disk.${_did} ${VOL_UID} (${_vol}) from ${_snap_uid}${_template:+ on ${_template}}"
    storpoolVolumeRename "${VOL_UID}" "${_vol}" "${_tmp_name}" "" || exit $?
    disksOldUid_a["${_did}"]="${VOL_UID}"
    trapAdd "restoreRollbackRename '${_did}'"
    trapAdd "restoreRollbackDelete '${_did}'"
    _xtype="${diskTypeMap_a[${_vol}]}"
    if [[ "${_did}" == "nvram" ]]; then
        _tag_k="img;${LOC_TAG};virt;${VM_TAG};${VC_POLICY:+vc-policy};${SP_QOSCLASS:+qc};type"
        _tag_v="${_vol};${LOC_TAG_VAL};one;${VM_ID};${VC_POLICY};${SP_QOSCLASS};${_xtype}"
    else
        _tag_k="img;${LOC_TAG};virt;diskid;${VM_TAG};${VC_POLICY:+vc-policy};${SP_QOSCLASS:+qc};type"
        _tag_v="${_vol};${LOC_TAG_VAL};one;${_did};${VM_ID};${VC_POLICY};${SP_QOSCLASS};${_xtype}"
    fi
    storpoolVolumeFromSnapshot "${_snap_uid}" "${_vol}" "${_template}" "${_tag_k}" "${_tag_v}"
    _ret=$?
    if [[ ${_ret} -ne 0 ]] || [[ -z "${SP_UID}" ]]; then
        error_message "Error creating ${_vol} from the backup snapshot ${_snap_uid}"
        exit "${_ret:-1}"
    fi
    disksNewUid_a["${_did}"]="${SP_UID}"
    if [[ ${X_SIZE} -lt ${V_SIZE} ]]; then
        storpoolVolumeResize "${SP_UID}" "${V_SIZE}" || exit $?
    fi
    storpoolAttach "${SP_UID}" "${DST_HOST}" || exit $?
    if [[ "${_did}" != "nvram" ]]; then
        oneSymlink "${DST_HOST}" "${SP_UID}" "${SYSTEM_DS_PATH}/disk.${_did}" || exit $?
    fi
    if [[ -n "${disksIngressUid_a[${_did}]:-}" ]]; then
        if DELAY_DELETE="" _SOFT_FAIL=1 storpoolDelete "${disksIngressUid_a[${_did}]}" "force"; then
            unset "disksIngressUid_a[${_did}]"
        else
            splog "[W] VM ${VM_ID} pulled snapshot ${disksIngressUid_a[${_did}]} of disk.${_did} not deleted ($?)"
        fi
    fi
    trapReset
    disksCommitted_a["${_did}"]=1
    trapAdd "restoreCommitCleanup"
}

function restoreServiceScratchDrop()
{
    [[ -n "${SVC_SCRATCH_UID}" ]] || return 0
    DELAY_DELETE="" _SOFT_FAIL=1 storpoolDelete "${SVC_SCRATCH_UID}" "force" && SVC_SCRATCH_UID=""
    if [[ -n "${SVC_PULL_UID}" ]]; then
        DELAY_DELETE="" _SOFT_FAIL=1 storpoolDelete "${SVC_PULL_UID}" "force" && SVC_PULL_UID=""
    fi
}

function restoreServiceTar()
{
    local _url="$1"
    local _scratch="${SYSTEM_DS_PATH}/.restore-${_TMP_NAME}" _tar="" _template="" _snap_uid="" _cmd="" _tpm_uid="" _tpm_vol="" _ret=0
    SVC_SCRATCH_UID=""
    SVC_PULL_UID=""
    _tar="${DS_BASE_PATH}/${VM_ID}/${BS_EPOCH}/svc.tar"
    ssh_forward ssh_exec_and_log "${DST_HOST}" "${REMOTE_HDR}
    rm -rf \"${_scratch}\"
    mkdir -p \"${_scratch}\"${REMOTE_FTR}" "Error creating ${_scratch} on ${DST_HOST}"
    trapAdd "ssh_forward ssh_exec_and_log_no_error '${DST_HOST}' 'rm -rf \"${_scratch}\"' 'Error removing ${_scratch} on ${DST_HOST}'"
    if [[ -f "${_tar}" ]]; then
        splog "[I] VM ${VM_ID} service tar ${_tar} from the front-end"
        if ! signalWait "${RSYNC:-rsync}" -a "${_tar}" "${DST_HOST}:${_scratch}/"; then
            error_message "Error copying ${_tar} to ${DST_HOST}:${_scratch}"
            exit 1
        fi
        ssh_forward ssh_exec_and_log "${DST_HOST}" "${REMOTE_HDR}
    tar -xf \"${_scratch}/svc.tar\" -C \"${_scratch}\"${REMOTE_FTR}" "Error extracting ${_scratch}/svc.tar on ${DST_HOST}"
    else
        splog "[I] VM ${VM_ID} no ${_tar} on the front-end, taking the service snapshot ${_url}"
        _template="$(spVolumeTemplateName "${VM_DS_ID}")"
        if ! oneSnapshotLookup "${_url}"; then
            error_message "Can't resolve the service URL ${_url}"
            exit 1
        fi
        if [[ -n "${REMOTE_ID}" ]]; then
            _template="$(spBackupPullTemplate "${_template}")"
            if ! storpoolSnapshotPullRemote "${ONE_PX}-sys-${VM_ID}-SVC-pull-${_TMP_NAME}" "${REMOTE_ID}" "${REMOTE_LOCATION}" "${_template}" \
                    "img;${LOC_TAG};virt;${VM_TAG}" "${ONE_PX}-sys-${VM_ID}-SVC-pull-${_TMP_NAME};${LOC_TAG_VAL};one;${VM_ID}"; then
                error_message "Error pulling the service snapshot ${REMOTE_ID} from ${REMOTE_LOCATION}"
                exit 1
            fi
            _snap_uid="${SP_UID}"
            SVC_PULL_UID="${_snap_uid}"
        else
            _snap_uid="${SNAPSHOT_NAME}"
        fi
        trapAdd "restoreServiceScratchDrop"
        storpoolVolumeFromSnapshot "${_snap_uid}" "${ONE_PX}-sys-${VM_ID}-SVC-${_TMP_NAME}" "${_template}" \
            "img;${LOC_TAG};virt;${VM_TAG};type" "${ONE_PX}-sys-${VM_ID}-SVC-${_TMP_NAME};${LOC_TAG_VAL};one;${VM_ID};SVC"
        _ret=$?
        if [[ ${_ret} -ne 0 ]] || [[ -z "${SP_UID}" ]]; then
            error_message "Error creating a scratch volume from the service snapshot ${_snap_uid}"
            exit "${_ret:-1}"
        fi
        SVC_SCRATCH_UID="${SP_UID}"
        storpoolAttach "${SVC_SCRATCH_UID}" "${DST_HOST}" || exit $?
        ssh_forward ssh_exec_and_log "${DST_HOST}" "${REMOTE_HDR}
    tar -xf \"/dev/storpool-byid/${SVC_SCRATCH_UID#*~}\" -C \"${_scratch}\"${REMOTE_FTR}" "Error extracting the service tar from ${SVC_SCRATCH_UID} on ${DST_HOST}"
        storpoolDetach "${SVC_SCRATCH_UID}" "force" "" "all"
        restoreServiceScratchDrop
        trapDel "restoreServiceScratchDrop"
    fi
    _cmd=$(cat <<EOF
    #
    if [[ -f "${_scratch}/nvram/path" ]]; then
        nvram_path="\$(cat "${_scratch}/nvram/path")"
        nvram_file="\$(find "${_scratch}/nvram" -maxdepth 1 -type f ! -name path | head -n 1)"
        if [[ -n "\${nvram_path}" && -n "\${nvram_file}" ]]; then
            mkdir -p "\$(dirname "\${nvram_path}")"
            cp -p "\${nvram_file}" "\${nvram_path}"
            splog "VM ${VM_ID} NVRAM \${nvram_file##*/} restored to \${nvram_path}"
        fi
    fi
EOF
)
    ssh_forward ssh_exec_and_log "${DST_HOST}" "${REMOTE_HDR}${_cmd}${REMOTE_FTR}" "Error restoring the NVRAM file of VM ${VM_ID} on ${DST_HOST}"
    if ssh_forward ssh_exec_and_log_no_error "${DST_HOST}" "test -f \"${_scratch}/disk.tpm.0\"" "" 2>/dev/null; then
        _tpm_vol="${ONE_PX}-sys-${VM_ID}-SWTPM"
        kvGetUid "${_tpm_vol}"
        _ret=$?
        if [[ ${_ret} -eq 1 ]]; then
            storpoolVolumeCreate "${_tpm_vol}" 4194304 "$(spVolumeTemplateName "${VM_DS_ID}")" \
                "type;${VM_TAG}" "SWTPM;${VM_ID}"
            _ret=$?
        fi
        if [[ ${_ret} -ne 0 ]] || [[ -z "${SP_UID}" ]]; then
            error_message "Can't look up or create ${_tpm_vol}"
            exit "${_ret:-1}"
        fi
        _tpm_uid="${SP_UID}"
        storpoolAttach "${_tpm_uid}" "${DST_HOST}" || exit $?
        ssh_forward ssh_exec_and_log "${DST_HOST}" "${REMOTE_HDR}
    dd if=\"${_scratch}/disk.tpm.0\" of=\"/dev/storpool-byid/${_tpm_uid#*~}\" bs=1M conv=fdatasync status=none
    rm -rf \"${SYSTEM_DS_PATH}/tpm\"${REMOTE_FTR}" "Error writing the vTPM state of VM ${VM_ID} to ${_tpm_vol} on ${DST_HOST}"
        storpoolDetach "${_tpm_uid}" "force" "" "all"
        tpmRestore "${VM_ID}" "${SYSTEM_DS_PATH}" "${DST_HOST}"
        splog "[I] VM ${VM_ID} vTPM state restored from the backup"
    fi
    ssh_forward ssh_exec_and_log_no_error "${DST_HOST}" "rm -rf \"${_scratch}\"" "Error removing ${_scratch} on ${DST_HOST}"
    trapDel "ssh_forward ssh_exec_and_log_no_error '${DST_HOST}' 'rm -rf \"${_scratch}\"' 'Error removing ${_scratch} on ${DST_HOST}'"
}

DST_HOST="${1%%:*}"
SYSTEM_DS_PATH="${1#*:}"
VM_ID="$2"
IMG_ID="$3"
INC_ID="$4"
DISK_ID="$5"
export SYSTEM_DS_PATH  # TBD: remove

#splog "$* //${#DRV_ACTION}"
oneVmInfo "${VM_ID}" "${DISK_ID}"
VM_XML="${TMPDIR}/oneVmInfo-${VM_ID}.XML"

oneBackupImageInfo "${IMG_ID}"
BACKUP_IMG_XML="${TMPDIR}/oneBackupImageInfo-${IMG_ID}.XML"

oneDatastoreInfo "${B_DATASTORE_ID:?}"

BS_EPOCH=""
if [[ "${DS_DS_MAD}" == "storpool" ]]; then
    oneBackupSourceParse "${B_IMAGE_SOURCE}" quiet || true
fi

SP_QOSCLASS="${VM_DISK_SP_QOSCLASS:-${VM_SP_QOSCLASS:-${DS_SP_QOSCLASS:-${DEFAULT_QOSCLASS}}}}"
debug_sp_qosclass

MSG="VM ${VM_ID} BackupID ${IMG_ID} '${B_IMAGE_NAME}'"
if [[ "${INC_ID}" != "-1" ]]; then
    MSG+=" Incremental ${INC_ID}"
fi
if [[ "${DISK_ID}" != "-1" ]]; then
    MSG+=" Disk ${DISK_ID} (size ${SIZE}M)"
else
    MSG+=" All disks"
    if boolTrue "B_BACKUP_VOLATILE"; then
        MSG+=" + volatile"
    else
        MSG+=" w/o volatile"
    fi
fi
splog "${MSG}"

BACKUP_MAD_LS="${DRIVER_PATH}/../../datastore/${DS_DS_MAD:?}/ls"

_errexit=0
case $- in
    *e*) _errexit=1; set +e ;;
    *) ;;
esac
_ls_json=$(backupDatastoreLs "${B_DATASTORE_ID}" "${VM_XML}" "${BACKUP_IMG_XML}" "${INC_ID}" "${BACKUP_MAD_LS}")
_ls_ret=$?
[[ ${_errexit} -eq 1 ]] && set -e

if [[ ${_ls_ret} -ne 0 ]]; then
    splog "[E] VM ${VM_ID} backup ls failed (${_ls_ret})"
    error_message "Error listing backup disks for VM ${VM_ID}"
    exit "${_ls_ret}"
fi

if ! printf '%s' "${_ls_json}" | jq -e 'type == "object" and length > 0' >/dev/null; then
    splog "[E] VM ${VM_ID} backup lists no disks"
    error_message "backup lists no disks for VM ${VM_ID}"
    exit 1
fi

if ! _disk_lines=$(printf '%s' "${_ls_json}" | jq -r 'to_entries[]|"\(.key) \(.value)"'); then
    splog "[E] VM ${VM_ID} backup ls output is not a disk map"
    error_message "backup ls output is not a disk map for VM ${VM_ID}"
    exit 1
fi

declare -A disksUrl_a
declare -A disksMap_a
declare -A diskTypeMap_a  # diskTypeMap_a[oneName]=DISK_TYPE
declare -A disksOldUid_a
declare -A disksNewUid_a
declare -A disksIngressUid_a  # disksIngressUid_a[did]=uid of the scratch volume
declare -A disksCommitted_a

while IFS=' ' read -r -u "${jqfh}" did url; do
    if [[ -z "${did}" ]]; then
        continue
    fi
    disksUrl_a["${did}"]="${url}"
done {jqfh}< <(printf '%s\n' "${_disk_lines}")
exec {jqfh}<&-

oneVmVolumes "${VM_ID}" "" "${VM_XML}"
for entry in ${vmDisksMap:-}; do
    _did="${entry##*:}"
    [[ -n "${_did}" ]] || continue
    disksMap_a["${_did}"]="${entry%:*}"
done
for entry in ${vmDisksTypeMap}; do
    # vmDisksTypeMap: 'oneName:DISK_TYPE ...'
    diskTypeMap_a["${entry%%:*}"]="${entry#*:}"  # diskTypeMap_a[oneName]=DISK_TYPE
done
_TMP_NAME=$(mktemp --dry-run tmRestoreXXXXXXXX)
RET=0
_selected=0
trapAdd "restoreCommitCleanup"
for did in ${!disksUrl_a[*]}; do
    if [[ ${DISK_ID} != "-1" ]] && [[ ${DISK_ID} != "${did}" ]]; then
        case "${did}" in
            nvram|svc) [[ "${DISK_ID}" == "0" ]] || continue ;;
            *) continue ;;
        esac
    fi
    _selected=1
    case "${disksUrl_a[${did}]}" in
        SPSNAPSHOT:*|SPREMOTE:*)
            if [[ "${did}" == "svc" ]]; then
                restoreServiceTar "${disksUrl_a[${did}]}"
            else
                restoreVolumeFromSnapshot "${did}" "${disksUrl_a[${did}]}"
            fi
            continue
            ;;
        *) ;;
    esac
    if [[ "${did}" == "tpm" ]]; then
        disksMap_a["${did}"]="${ONE_PX}-sys-${VM_ID}-SWTPM"
        diskTypeMap_a["${disksMap_a[${did}]}"]="SWTPM"
    fi
    SP_VOL="${disksMap_a[${did}]}"
    TMP_NAME="${SP_VOL}-${_TMP_NAME}"
    BACKUP_URL="${disksUrl_a[${did}]}"
    COPY_CMD="${DRIVER_PATH}/../../datastore/downloader.sh --nodecomp \"${BACKUP_URL}\" -"
    if [[ "${did}" == "tpm" ]]; then
        kvGetUid "${SP_VOL}"
        _kvret=$?
        if [[ ${_kvret} -eq 1 ]]; then
            storpoolVolumeCreate "${SP_VOL}" 4194304
            _kvret=$?
        fi
        if [[ ${_kvret} -ne 0 ]]; then
            splog "[E] VM ${VM_ID} ${SP_VOL} not restored, KV lookup failed (${_kvret})"
            error_message "Can't look up ${SP_VOL}"
            exit "${_kvret}"
        fi
    else
        kvGetUid "${SP_VOL}" fatal
    fi
    storpoolVolumeInfo "${SP_UID:?}"
    if [[ -z "${V_SIZE}" ]]; then
        splog "[E] VM ${VM_ID} volume ${SP_UID} (${SP_VOL}) not found"
        error_message "volume ${SP_VOL} not found"
        exit 1
    fi
    VOL_UID="${SP_UID}"
    splog "VM ${VM_ID} restoring disk.${did} ${SP_UID} (${SP_VOL})"
    storpoolVolumeRename "${VOL_UID}" "${SP_VOL}" "${TMP_NAME}" ""  # TBD: "${TAGS}"
    RET=$?
    disksOldUid_a["${did}"]="${VOL_UID}"
    trapAdd "restoreRollbackRename '${did}'"
    trapAdd "restoreRollbackDelete '${did}'"
    if [[ ${RET} -eq 0 ]]; then # 1
        xTYPE="${diskTypeMap_a[${SP_VOL}]}"
        storpoolVolumeCreate "${SP_VOL}" "${V_SIZE}" "${V_TEMPLATE_NAME:?}" \
            "virt;${LOC_TAG};diskid;${VM_TAG};${VC_POLICY:+vc-policy};${SP_QOSCLASS:+qc};type" \
            "one;${LOC_TAG_VAL};${did};${VM_ID};${VC_POLICY};${SP_QOSCLASS};${xTYPE}"  # TBD: tag after image operation to improve performance
        RET=$?
        SP_LINK="/dev/storpool-byid/${SP_UID#*~}"
        if [[ ${RET} -eq 0 ]]; then # 2
            disksNewUid_a["${did}"]="${SP_UID}"
            storpoolAttach "${SP_UID}" "${DST_HOST}"
            RET=$?
            if [[ ${RET} -eq 0 ]]; then # 3
                if [[ "${did}" == "tpm" ]]; then
                    # disk.tpm.0 is a tar.gz; tpmRestore extracts it from the volume
                    restoreCopyToLink "${SP_LINK}"
                    RET=$?
                else
                    # a qcow2 of a fully written disk is larger than its virtual size
                    INGRESS_VOL="${SP_VOL}-ing-${_TMP_NAME}"
                    INGRESS_SIZE=$(( (V_SIZE + V_SIZE / 64 + 16 * 1048576 + 1048575) / 1048576 * 1048576 ))
                    _SOFT_FAIL=1 storpoolVolumeCreate "${INGRESS_VOL}" "${INGRESS_SIZE}" "${V_TEMPLATE_NAME}"
                    RET=$?
                    if [[ ${RET} -eq 0 ]] && [[ -n "${SP_UID}" ]]; then
                        INGRESS_UID="${SP_UID}"
                        disksIngressUid_a["${did}"]="${INGRESS_UID}"
                        INGRESS_LINK="/dev/storpool-byid/${INGRESS_UID#*~}"
                        _SOFT_FAIL=1 storpoolAttach "${INGRESS_UID}" "${DST_HOST}"
                        RET=$?
                        if [[ ${RET} -eq 0 ]]; then
                            restoreCopyToLink "${INGRESS_LINK}"
                            RET=$?
                        fi
                        if [[ ${RET} -eq 0 ]]; then
                            qemu_img_info "${INGRESS_LINK}" "${DST_HOST}"
                            RET=$?
                            if [[ ${RET} -ne 0 ]] || [[ -z "${QEMU_IMG_FORMAT}" ]]; then
                                splog "[E] VM ${VM_ID} disk.${did} qemu-img info failed on ${DST_HOST}:${INGRESS_LINK}"
                                error_message "qemu-img info failed on ${DST_HOST}:${INGRESS_LINK}"
                                RET=1
                            elif [[ "${QEMU_IMG_VIRTUAL_SIZE}" -gt "${V_SIZE}" ]]; then
                                splog "[E] VM ${VM_ID} disk.${did} backup virtual-size ${QEMU_IMG_VIRTUAL_SIZE} > volume ${V_SIZE}"
                                error_message "backup virtual-size ${QEMU_IMG_VIRTUAL_SIZE} > volume ${V_SIZE}"
                                RET=1
                            else
                                if [[ "${QEMU_IMG_VIRTUAL_SIZE}" -lt "${V_SIZE}" ]]; then
                                    splog "[W] VM ${VM_ID} disk.${did} backup virtual-size ${QEMU_IMG_VIRTUAL_SIZE} < volume ${V_SIZE}"
                                fi
                                POST_COPY_CMD=$(cat <<EOF
set -e
export PATH=/bin:/sbin:/usr/bin:/usr/sbin:\$PATH
${QEMU_IMG:-qemu-img} convert -f ${QEMU_IMG_FORMAT} -t none -T none -O raw -S 4k ${INGRESS_LINK} ${SP_LINK}
sync
EOF
)
                                splog "${QEMU_IMG_FORMAT} qemu-img convert -f ${QEMU_IMG_FORMAT} -t none -T none -O raw -S 4k ${INGRESS_LINK} ${SP_LINK}"
                                ssh_exec_and_log_no_error "${DST_HOST}" "${POST_COPY_CMD}" \
                                    "Error converting ${BACKUP_URL} on ${DST_HOST}"
                                RET=$?
                            fi
                        fi
                        DELAY_DELETE="" storpoolDelete "${INGRESS_UID}" "force"
                        INGRESS_RET=$?
                        if [[ ${INGRESS_RET} -eq 0 ]]; then
                            unset "disksIngressUid_a[${did}]"
                        else
                            splog "[E] VM ${VM_ID} ingress volume ${INGRESS_UID} (${INGRESS_VOL}) not deleted"
                        fi
                    else
                        [[ ${RET} -ne 0 ]] || RET=1
                    fi
                    SP_UID="${disksNewUid_a[${did}]}"
                fi
                if [[ ${RET} -eq 0 ]]; then # 4
                    DST_PATH="${SYSTEM_DS_PATH}/disk.${did}"
                    oneSymlink "${DST_HOST}" "${SP_UID}" "${DST_PATH}"
                    RET=$?
                    if [[ ${RET} -ne 0 ]]; then
                        error_message "Error linking ${DST_PATH} on ${DST_HOST}"
                        exit "${RET}"
                    fi
                else
                    exit "${RET}"
                fi
            else
                exit "${RET}"
            fi
        else
            exit "${RET}"
        fi
    else
        exit "${RET}"
    fi

    trapReset
    disksCommitted_a["${did}"]=1
    trapAdd "restoreCommitCleanup"
    if [[ "${did}" == "tpm" ]]; then
        tpmRestore "${VM_ID}" "${SYSTEM_DS_PATH}" "${DST_HOST}"
    fi

done

if [[ ${_selected} -eq 0 ]]; then
    splog "[E] VM ${VM_ID} backup has no disk to restore"
    error_message "backup has no disk to restore for VM ${VM_ID}"
    exit 1
fi

trapReset
restoreDropForgottenSnapshots
_cleanup_ret=0
for did in ${!disksUrl_a[*]}; do
    if [[ "${DISK_ID}" != "-1" ]]; then
        if [[ "${DISK_ID}" != "${did}" ]]; then
            continue
        fi
    fi
    [[ "${did}" != "svc" ]] || continue
    SP_VOL="${disksMap_a[${did}]:-}"
    TMP_NAME="${SP_VOL}-${_TMP_NAME}"
    if [[ -n "${disksIngressUid_a[${did}]:-}" ]]; then
        splog "[I] VM ${VM_ID} delete ingress volume ${disksIngressUid_a[${did}]}"
        DELAY_DELETE="" _SOFT_FAIL=1 storpoolDelete "${disksIngressUid_a[${did}]}" "force"
        _dret=$?
        [[ ${_dret} -eq 0 ]] || _cleanup_ret=${_dret}
    fi
    OLD_UID="${disksOldUid_a[${did}]:-}"
    if [[ -n "${OLD_UID}" ]]; then
        splog "[I] VM ${VM_ID} Restore success, cleaning up ${OLD_UID} (${TMP_NAME})"
        DELAY_DELETE="" _SOFT_FAIL=1 storpoolDelete "${OLD_UID}" "force" "" "" "\"reason\":\"tm_restore\""
        _dret=$?
        [[ ${_dret} -eq 0 ]] || _cleanup_ret=${_dret}
    fi
done

splog "END ${VM_ID}"
exit "${_cleanup_ret}"
