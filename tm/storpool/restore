DRIVER_PATH="$(dirname "$0")"

# shellcheck source=/dev/null
source "${DRIVER_PATH}/../../scripts_common.sh"
# shellcheck source=tm/storpool/storpool_common.sh
source "${DRIVER_PATH}/../../tm/storpool/storpool_common.sh"

# returns on error (multiline_exec_and_log exits), so the rollback runs
function restoreCopyToLink()
{
    local _LINK="$1"
    local _PIPE="" _ERR="" _RET=0
    _PIPE="set -e -o pipefail; eval ${COPY_CMD//&/\\&} | ${SSH:-ssh} ${DST_HOST} ${DD:-dd} of=${_LINK} bs=\"${COPY_CMD_DD_BS:-1M}\" status=none iflag=fullblock oflag=direct"
    splog "${_PIPE}"
    _ERR=$(bash -c "${_PIPE}" 2>&1 1>/dev/null)
    _RET=$?
    if [[ ${_RET} -ne 0 ]]; then
        splog "[E] Error restoring ${BACKUP_URL} to ${DST_HOST}:${_LINK} (${_RET}) ${_ERR}"
        error_message "Error restoring ${BACKUP_URL} to ${DST_HOST}:${_LINK}"
    fi
    return "${_RET}"
}

DST_HOST="${1%%:*}"
SYSTEM_DS_PATH="${1#*:}"
VM_ID="$2"
IMG_ID="$3"
INC_ID="$4"
DISK_ID="$5"
export SYSTEM_DS_PATH  # TBD: remove

#splog "$* //${#DRV_ACTION}"
oneVmInfo "${VM_ID}" "${DISK_ID}"
VM_XML="${TMPDIR}/oneVmInfo-${VM_ID}.XML"

oneBackupImageInfo "${IMG_ID}"
BACKUP_IMG_XML="${TMPDIR}/oneBackupImageInfo-${IMG_ID}.XML"

trapAdd 'unset DS_RESTIC_PASSWORD'
oneDatastoreInfo "${B_DATASTORE_ID:?}" "" secrets
BACKUP_DS_XML="${TMPDIR}/oneDatastoreInfo-${B_DATASTORE_ID}.XML"

SP_QOSCLASS="${VM_DISK_SP_QOSCLASS:-${VM_SP_QOSCLASS:-${DS_SP_QOSCLASS:-${DEFAULT_QOSCLASS}}}}"
debug_sp_qosclass

MSG="VM ${VM_ID} BackupID ${IMG_ID} '${B_IMAGE_NAME}'"
if [[ "${INC_ID}" != "-1" ]]; then
    MSG+=" Incremental ${INC_ID}"
fi
if [[ "${DISK_ID}" != "-1" ]]; then
    MSG+=" Disk ${DISK_ID} (size ${SIZE}M)"
else
    MSG+=" All disks"
    if boolTrue "B_BACKUP_VOLATILE"; then
        MSG+=" + volatile"
    else
        MSG+=" w/o volatile"
    fi
fi
splog "${MSG}"

BACKUP_MAD_LS="${DRIVER_PATH}/../../datastore/${DS_DS_MAD:?}/ls"

if [[ "${DS_DS_MAD}" == "restic" && -z "${DS_RESTIC_PASSWORD+x}" ]]; then
    splog "[E] VM ${VM_ID} RESTIC_PASSWORD unavailable"
    error_message "RESTIC_PASSWORD unavailable for VM ${VM_ID}"
    exit 1
fi

# The listing document is a pipe. Plaintext RESTIC_PASSWORD exists only inside
# that pipe; the datastore file on disk still holds the ciphertext.
_errexit=0
_xtrace=0
case $- in
    *e*) _errexit=1; set +e ;;
    *) ;;
esac
case $- in
    *x*) _xtrace=1; set +x ;;
    *) ;;
esac
_ls_json=$(
    {
        printf '%s\n' '<DS_DRIVER_ACTION_DATA>'
        datastoreXmlWithBackupSecrets < "${BACKUP_DS_XML}"
        _inject_ret=$?
        if [[ ${_inject_ret} -ne 0 ]]; then
            exit "${_inject_ret}"
        fi
        cat "${VM_XML}"
        _cat_ret=$?
        if [[ ${_cat_ret} -ne 0 ]]; then
            exit "${_cat_ret}"
        fi
        cat "${BACKUP_IMG_XML}"
        _cat_ret=$?
        if [[ ${_cat_ret} -ne 0 ]]; then
            exit "${_cat_ret}"
        fi
        printf '%s\n' '</DS_DRIVER_ACTION_DATA>'
    } | "${BACKUP_MAD_LS}" -i "${INC_ID}"
)
_ls_ret=$?
unset DS_RESTIC_PASSWORD
[[ ${_xtrace} -eq 1 ]] && set -x
[[ ${_errexit} -eq 1 ]] && set -e

if [[ ${_ls_ret} -ne 0 ]]; then
    splog "[E] VM ${VM_ID} backup ls failed (${_ls_ret})"
    error_message "Error listing backup disks for VM ${VM_ID}"
    exit "${_ls_ret}"
fi

if ! printf '%s' "${_ls_json}" | jq -e 'type == "object" and length > 0' >/dev/null; then
    splog "[E] VM ${VM_ID} backup lists no disks"
    error_message "backup lists no disks for VM ${VM_ID}"
    exit 1
fi

if ! _disk_lines=$(printf '%s' "${_ls_json}" | jq -r 'to_entries[]|"\(.key) \(.value)"'); then
    splog "[E] VM ${VM_ID} backup ls output is not a disk map"
    error_message "backup ls output is not a disk map for VM ${VM_ID}"
    exit 1
fi

declare -A disksUrl_a
declare -A disksMap_a
declare -A diskTypeMap_a  # diskTypeMap_a[oneName]=DISK_TYPE
declare -A disksOldUid_a
declare -A disksNewUid_a
declare -A disksIngressUid_a  # disksIngressUid_a[did]=uid of the scratch volume

while IFS=' ' read -r -u "${jqfh}" did url; do
    if [[ -z "${did}" ]]; then
        continue
    fi
    disksUrl_a["${did}"]="${url}"
done {jqfh}< <(printf '%s\n' "${_disk_lines}")
exec {jqfh}<&-

oneVmVolumes "${VM_ID}" "" "${VM_XML}"
for entry in ${vmDisksMap:-}; do
    # URL:DISK_ID
    disksMap_a["${entry##*:}"]="${entry%:*}"
done
for entry in ${vmDisksTypeMap}; do
    # vmDisksTypeMap: 'oneName:DISK_TYPE ...'
    diskTypeMap_a["${entry%%:*}"]="${entry#*:}"  # diskTypeMap_a[oneName]=DISK_TYPE
done
_TMP_NAME=$(mktemp --dry-run tmRestoreXXXXXXXX)
ERROR=0
RET=0
_selected=0
for did in ${!disksUrl_a[*]}; do
    if [[ ${DISK_ID} != "-1" ]]; then
        if [[ ${DISK_ID} != "${did}" ]]; then
            continue
        fi
    fi
    _selected=1
    if [[ "${did}" == "tpm" ]]; then
        disksMap_a["${did}"]="${ONE_PX}-sys-${VM_ID}-SWTPM"
        diskTypeMap_a["${disksMap_a[${did}]}"]="SWTPM"
        DISK_ID=""
    fi
    SP_VOL="${disksMap_a[${did}]}"
    TMP_NAME="${SP_VOL}-${_TMP_NAME}"
    BACKUP_URL="${disksUrl_a[${did}]}"
    COPY_CMD="${DRIVER_PATH}/../../datastore/downloader.sh --nodecomp \"${BACKUP_URL}\" -"
    kvGetUid "${SP_VOL}" fatal
    storpoolVolumeInfo "${SP_UID:?}"
    if [[ -z "${V_SIZE}" ]]; then
        if [[ "${did}" == "tpm" ]]; then
            V_SIZE="4M"
            storpoolVolumeCreate "${SP_VOL}" "${V_SIZE}"
        fi
        splog "VM ${VM_ID} volume ${SP_UID} (${SP_VOL}) not found"
        ERROR=1
        break
    fi
    VOL_UID="${SP_UID}"
    splog "VM ${VM_ID} restoring disk.${did} ${SP_UID} (${SP_VOL})"
    storpoolVolumeRename "${VOL_UID}" "${SP_VOL}" "${TMP_NAME}" ""  # TBD: "${TAGS}"
    RET=$?
    if [[ ${RET} -eq 0 ]]; then # 1
        disksOldUid_a["${did}"]="${VOL_UID}"
        xTYPE="${diskTypeMap_a[${SP_VOL}]}"
        storpoolVolumeCreate "${SP_VOL}" "${V_SIZE}" "${V_TEMPLATE_NAME:?}" \
            "virt;${LOC_TAG};diskid;${VM_TAG};${VC_POLICY:+vc-policy};${SP_QOSCLASS:+qc};type" \
            "one;${LOC_TAG_VAL};${did};${VM_ID};${VC_POLICY};${SP_QOSCLASS};${xTYPE}"  # TBD: tag after image operation to improve performance
        RET=$?
        SP_LINK="/dev/storpool-byid/${SP_UID#*~}"
        if [[ ${RET} -eq 0 ]]; then # 2
            disksNewUid_a["${did}"]="${SP_UID}"
            storpoolAttach "${SP_UID}" "${DST_HOST}"
            RET=$?
            if [[ ${RET} -eq 0 ]]; then # 3
                if [[ "${did}" == "tpm" ]]; then
                    # disk.tpm.0 is a tar.gz; tpmRestore extracts it from the volume
                    restoreCopyToLink "${SP_LINK}"
                    RET=$?
                else
                    # a qcow2 of a fully written disk is larger than its virtual size
                    INGRESS_VOL="${SP_VOL}-ing-${_TMP_NAME}"
                    INGRESS_SIZE=$(( (V_SIZE + V_SIZE / 64 + 16 * 1048576 + 1048575) / 1048576 * 1048576 ))
                    _SOFT_FAIL=1 storpoolVolumeCreate "${INGRESS_VOL}" "${INGRESS_SIZE}" "${V_TEMPLATE_NAME}"
                    RET=$?
                    if [[ ${RET} -eq 0 ]] && [[ -n "${SP_UID}" ]]; then
                        INGRESS_UID="${SP_UID}"
                        disksIngressUid_a["${did}"]="${INGRESS_UID}"
                        INGRESS_LINK="/dev/storpool-byid/${INGRESS_UID#*~}"
                        _SOFT_FAIL=1 storpoolAttach "${INGRESS_UID}" "${DST_HOST}"
                        RET=$?
                        if [[ ${RET} -eq 0 ]]; then
                            restoreCopyToLink "${INGRESS_LINK}"
                            RET=$?
                        fi
                        if [[ ${RET} -eq 0 ]]; then
                            qemu_img_info "${INGRESS_LINK}" "${DST_HOST}"
                            RET=$?
                            if [[ ${RET} -ne 0 ]] || [[ -z "${QEMU_IMG_FORMAT}" ]]; then
                                splog "[E] VM ${VM_ID} disk.${did} qemu-img info failed on ${DST_HOST}:${INGRESS_LINK}"
                                error_message "qemu-img info failed on ${DST_HOST}:${INGRESS_LINK}"
                                RET=1
                            elif [[ "${QEMU_IMG_VIRTUAL_SIZE}" -gt "${V_SIZE}" ]]; then
                                splog "[E] VM ${VM_ID} disk.${did} backup virtual-size ${QEMU_IMG_VIRTUAL_SIZE} > volume ${V_SIZE}"
                                error_message "backup virtual-size ${QEMU_IMG_VIRTUAL_SIZE} > volume ${V_SIZE}"
                                RET=1
                            else
                                if [[ "${QEMU_IMG_VIRTUAL_SIZE}" -lt "${V_SIZE}" ]]; then
                                    splog "[W] VM ${VM_ID} disk.${did} backup virtual-size ${QEMU_IMG_VIRTUAL_SIZE} < volume ${V_SIZE}"
                                fi
                                POST_COPY_CMD=$(cat <<EOF
set -e
export PATH=/bin:/sbin:/usr/bin:/usr/sbin:\$PATH
${QEMU_IMG:-qemu-img} convert -f ${QEMU_IMG_FORMAT} -t none -T none -O raw -S 4k ${INGRESS_LINK} ${SP_LINK}
sync
EOF
)
                                splog "${QEMU_IMG_FORMAT} qemu-img convert -f ${QEMU_IMG_FORMAT} -t none -T none -O raw -S 4k ${INGRESS_LINK} ${SP_LINK}"
                                ssh_exec_and_log_no_error "${DST_HOST}" "${POST_COPY_CMD}" \
                                    "Error converting ${BACKUP_URL} on ${DST_HOST}"
                                RET=$?
                            fi
                        fi
                        DELAY_DELETE="" storpoolDelete "${INGRESS_UID}" "force"
                        INGRESS_RET=$?
                        if [[ ${INGRESS_RET} -eq 0 ]]; then
                            unset "disksIngressUid_a[${did}]"
                        else
                            splog "[E] VM ${VM_ID} ingress volume ${INGRESS_UID} (${INGRESS_VOL}) not deleted"
                        fi
                    else
                        [[ ${RET} -ne 0 ]] || RET=1
                    fi
                    SP_UID="${disksNewUid_a[${did}]}"
                fi
                if [[ ${RET} -eq 0 ]]; then # 4
                    DST_PATH="${SYSTEM_DS_PATH}/disk.${did}"
                    oneSymlink "${DST_HOST}" "${SP_UID}" "${DST_PATH}"
                    RET=$?
                    if [[ ${RET} -ne 0 ]]; then # 5
                        ERROR=5
                        break
                    fi
                else
                    ERROR=4
                    break
                fi
            else
                ERROR=3
                break
            fi
        else
            ERROR=2
            break
        fi
    else
        ERROR=1
        break
    fi

    if [[ "${did}" == "tpm" ]]; then
        tpmRestore "${VM_ID}" "${SYSTEM_DS_PATH}" "${DST_HOST}"
    fi

done

if [[ ${_selected} -eq 0 ]]; then
    splog "[E] VM ${VM_ID} backup has no disk to restore"
    error_message "backup has no disk to restore for VM ${VM_ID}"
    exit 1
fi

for did in ${!disksUrl_a[*]}; do
    if [[ "${DISK_ID}" != "-1" ]]; then
        if [[ "${DISK_ID}" != "${did}" ]]; then
            continue
        fi
    fi
    BACKUP_URL="${disksUrl_a[${did}]}"
    SP_VOL="${disksMap_a[${did}]}"
    TMP_NAME="${SP_VOL}-${_TMP_NAME}"
    if [[ -n "${disksIngressUid_a[${did}]:-}" ]]; then
        splog "[I] VM ${VM_ID} delete ingress volume ${disksIngressUid_a[${did}]}"
        DELAY_DELETE="" storpoolDelete "${disksIngressUid_a[${did}]}" "force"
    fi
    if [[ ${ERROR} -eq 0 ]]; then
        OLD_UID="${disksOldUid_a[${did}]}"
        splog "[I] VM ${VM_ID} Restore success, cleaning up ${OLD_UID} (${TMP_NAME})"
        storpoolDelete "${OLD_UID}" "force" "" "" "\"reason\":\"tm_restore\""
    else
        splog "[E] VM ${VM_ID} Error:${ERROR} Restore failed, trying to rollback ${SP_UID}"
        case "${ERROR}" in
            3|4|5)
                NEW_UID="${disksNewUid_a[${did}]}"
                splog "[I] VM ${VM_ID} delete volume ${NEW_UID} (the new one)"
                storpoolDelete "${NEW_UID}" "force"
                ;&
            2)
                OLD_UID="${disksOldUid_a[${did}]}"
                splog "[I] VM ${VM_ID} rename temp volume ${OLD_UID} (${TMP_NAME}) to ${SP_VOL}"
                storpoolVolumeRename "${OLD_UID}" "${TMP_NAME}" "${SP_VOL}"
                ;;
            *)
                storpoolVolumeInfo "${OLD_UID}"
        esac
    fi
done

splog "END ${VM_ID}"
exit "${RET}"
