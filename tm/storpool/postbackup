DRIVER_PATH="$(dirname "${0}")"

#shellcheck source=/dev/null
source "${DRIVER_PATH}/../../scripts_common.sh"
#shellcheck source=tm/storpool/storpool_common.sh
source "${DRIVER_PATH}/storpool_common.sh"

splog "${*}"

if [[ -t 0 ]]; then
    msg="Interactive mode not supported"
    splog "${msg}"
    error_message "${msg}"
    exit 1
fi

KVMHOST="${1%%:*}"
VMDIR="${1#*:}"
DISKS="$2"
DEPLOY_ID="$3"
VM_ID="$4"
SYSDS_ID="$5"
if [[ -n "$6" ]]; then
    BJ_ID="$4"
    VM_ID="$5"
    SYSDS_ID="$6"
fi
export DISKS BJ_ID

if boolTrue "DEBUG_POSTBACKUP"; then
    splog "${KVMHOST} ${VMDIR} ${DISKS} ${DEPLOY_ID}${BJ_ID:+ ${BJ_ID}} ${VM_ID} ${SYSDS_ID}"
fi

oneDatastoreInfo "${SYSDS_ID}"

oneHostInfo "${KVMHOST}"

VM_XML="$(mktemp -t "postbackup-${VM_ID}-XXXXXXXX")"
trapAdd "rm -f \"${VM_XML}\""
cat > "${VM_XML}"

oneBackupTarget "${KVMHOST}" "${VMDIR}" "${VM_ID}" "${VM_XML}"

oneVmVolumes "${VM_ID}" "" "${VM_XML}" "${DISKS}"

BACKUP_NATIVE=0
SP_BACKUP_MODE=""
if [[ -n "${BACKUP_DS_ID}" ]]; then
    oneBackupDsInfo "${BACKUP_DS_ID}"
    if [[ "${BACKUP_DS_MAD}" == "storpool" ]]; then
        BACKUP_NATIVE=1
        SP_BACKUP_MODE="$(oneBackupModeName)"
    fi
fi

if [[ ${BACKUP_NATIVE} -eq 1 ]]; then
    if [[ -d "${B_LOCAL}" ]]; then
        splog "[I] VM ${VM_ID} ${SP_BACKUP_MODE} backup not handed over, dropping the backup in progress"
        if oneBackupInflight "${VM_ID}" "${SP_BACKUP_MODE}" "${DISKS}" "${BACKUP_DROP_WAIT:-30}"; then
            for did in "${!BI_IDS_A[@]}"; do
                sId="${BI_IDS_A[${did}]}"
                if [[ "${SP_BACKUP_MODE}" == "remote" ]]; then
                    splog "[I] VM ${VM_ID} epoch ${BI_EPOCH} ${did}: dropping the transient ~${sId} and its copy"
                    storpoolBackupSnapshotDrop "${sId}"
                    bLoc="$(storpoolRemoteCopies "${sId}" | awk '{print $2}' | head -n 1 || true)"
                    storpoolBackupCopyDrop "${sId}" "${bLoc:-${SP_BACKUP_LOCATION}}"
                else
                    splog "[I] VM ${VM_ID} epoch ${BI_EPOCH} ${did}: dropping the snapshot ~${sId}"
                    storpoolBackupSnapshotDrop "${sId}"
                fi
            done
            if [[ "${BI_SVC_UID}" != "-" ]] && [[ -n "${BI_SVC_UID}" ]]; then
                DELAY_DELETE="" _SOFT_FAIL=1 storpoolDelete "${BI_SVC_UID}" "force"
            fi
            oneBackupKvDel "${VM_ID}" "${BI_EPOCH}"
        else
            splog "[W] VM ${VM_ID} no backup in progress found to drop"
        fi
        for sUid in $(oneBackupSvcVolumes "${VM_ID}"); do
            splog "[I] VM ${VM_ID} dropping the service volume ${sUid}"
            DELAY_DELETE="" _SOFT_FAIL=1 storpoolDelete "${sUid}" "force"
        done
        rm -rf "${B_LOCAL}"
        splog "[I] post-clean completed ($?)"
    else
        splog "[I] VM ${VM_ID} backup handed over, nothing to drop"
    fi
elif [[ -d "${B_LOCAL}" ]]; then
    splog "[I] post-clean ${B_LOCAL} ..."
    snapshots_list="${B_LOCAL}/.storpool_snapshots"
    if [[ -f ${snapshots_list} ]]; then
        while read -r -u "${spfh}" volume sGlobalId sName; do
            if boolTrue "DEBUG_BACKUP"; then
                splog "[D] Removing snapshot ${sName}(${sGlobalId}) volume ${volume}"
            else
                splog "[I]Removing snapshot ${sName} volume ${volume}"
            fi
            json="{\"snapshot\":\"${sName}\",\"detach\":\"all\",\"force\":true}"
            DO_MULTICLUSTER=1 DO_REMOTE="" storpoolRetry VolumesReassignWait "\"reassign\":[${json}]"
            SKIP_KV_DATA=1 storpoolSnapshotDelete "${sName}"
        done {spfh}< <(cat "${snapshots_list}" || true)
        exec {spfh}<&-
    fi
    rm -rf "${B_LOCAL}"
    splog "[I] post-clean completed ($?)"
else
    splog "[W] Folder not found. ${B_LOCAL}"
fi

oneBackupRemoveDir "${KVMHOST}" "${B_DISK_DIR}"
if [[ "${B_HOST}:${B_DIR}" != "${KVMHOST}:${B_DISK_DIR}" ]]; then
    oneBackupRemoveDir "${B_HOST}" "${B_DIR}"
fi

splog "END"
