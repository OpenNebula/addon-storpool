# mkimage size format host:remote_system_ds/disk.i vmid dsid
#   - size in MB of the image
#   - format for the image
#   - host is the target host to deploy the VM
#   - remote_system_ds is the path for the system datastore in the host
#   - vmid is the id of the VM
#   - dsid is the target datastore (0 is the system datastore)

#-------------------------------------------------------------------------------
# Get mkimage arguments from OpenNebula core
#-------------------------------------------------------------------------------

SIZE="$1"
FSTYPE="$2"
DST="$3"
VM_ID="$4"
DS_ID="$5"

DRIVER_PATH="$(dirname "$0")"
# shellcheck source=tm/storpool/storpool_common.sh
source "${DRIVER_PATH}/storpool_common.sh"

# shellcheck source=/dev/null
source "${DRIVER_PATH}/../../datastore/libfs.sh"

if [[ -f "${DRIVER_PATH}/../../etc/datastore/datastore.conf" ]]; then
    # shellcheck source=/dev/null
    source "${DRIVER_PATH}/../../etc/datastore/datastore.conf"
fi

splog "SIZE=${SIZE} FSTYPE=${FSTYPE} DST=${DST} VM_ID=${VM_ID} DS_ID=${DS_ID}${SUPPORTED_FS:+ SUPPORTED_FS=${SUPPORTED_FS}}${FS_OPTS:+ FS_OPTS=${FS_OPTS}}"

if [[ "${FSTYPE,,}" != "raw" ]] && [[ "${FSTYPE,,}" != "swap" ]]; then
    msg="Unsupported FSTYPE '${FSTYPE}'! Please use 'raw'."
    log_error "${msg}"
    splog "${msg}"
    exit 1
fi

#-------------------------------------------------------------------------------
# Get template information from datastore TEMPLATE definition
#-------------------------------------------------------------------------------

oneDatastoreInfo "${DS_ID}"

#-------------------------------------------------------------------------------
# Set dst path and dirs
#-------------------------------------------------------------------------------

DST_PATH=$(arg_path "${DST}")
DST_HOST=$(arg_host "${DST}")

DISK_ID=$(echo "${DST}" | awk -F. '{print $NF}')

oneVmInfo "${VM_ID}" "${DISK_ID}"

if [[ -n "${DRIVER}" ]] && [[ "${DRIVER,,}" != "raw" ]]; then
    msg="Unsupported DRIVER format '${DRIVER}'! Please use 'raw'."
    log_error "${msg}"
    splog "${msg}"
    exit 1
fi

# Same rule as datastore/storpool/mkfs: an FS outside SUPPORTED_FS fails the
# action instead of leaving a raw volume.
_SUPPORTED_FS="${SUPPORTED_FS:-ext2,ext3,ext4,xfs}"
if [[ -n "${FS}" ]]; then
    if ! type -t contains &>/dev/null; then
        msg="Cannot check FS='${FS}': contains() is not defined"
        log_error "${msg}"
        splog "${msg}"
        exit 1
    fi
    if ! contains "${_SUPPORTED_FS}" "${FS}" ","; then
        msg="Unsupported file system type: ${FS}. Supported types are: ${_SUPPORTED_FS}"
        log_error "${msg}"
        splog "${msg}"
        exit 1
    fi
    splog "FS:'${FS}' is SUPPORTED_FS:${_SUPPORTED_FS}"
fi

SP_QOSCLASS="${VM_DISK_SP_QOSCLASS:-${VM_SP_QOSCLASS:-${DS_SP_QOSCLASS:-${DEFAULT_QOSCLASS}}}}"
debug_sp_qosclass

if boolTrue "MULTICLUSTER"; then
   oneHostInfo "${DST_HOST}"
   DO_REMOTE="~${HOST_SP_CLUSTER_ID}"
fi

#-------------------------------------------------------------------------------
# Create image
#-------------------------------------------------------------------------------

SP_VOL="${ONE_PX}-sys-${VM_ID}-${DISK_ID}"
SP_TEMPLATE="$(spVolumeTemplateName "${DS_ID}")"

OLD_UID=""
if storpoolVolumeExists "${SP_VOL}" byName; then
    OLD_UID="${SP_UID}"
    splog "[I] ${SP_VOL} exists as ${OLD_UID}; creating the replacement first"
fi
CREATE_VOL="${SP_VOL}"
if [[ -n "${OLD_UID}" ]]; then
    CREATE_VOL="${SP_VOL}-repl-$(mktemp --dry-run XXXXXXXX)"
fi

storpoolVolumeCreate "${CREATE_VOL}" "$((SIZE*1024*1024))" "${SP_TEMPLATE}" \
    "diskid;${VM_TAG};fs;type;${VC_POLICY:+vc-policy};${SP_QOSCLASS:+qc}" \
    "${DISK_ID};${VM_ID};${FS};VOL${FSTYPE^^};${VC_POLICY};${SP_QOSCLASS}"

VOL_UID="${SP_UID}"
if [[ -n "${OLD_UID}" ]]; then
    _SOFT_FAIL=1 storpoolVolumeRename "${VOL_UID}" "${CREATE_VOL}" "${SP_VOL}" "${SP_TEMPLATE}"
    _ret=$?
    if [[ ${_ret} -ne 0 ]]; then
        kvPut "${SP_VOL}" "${OLD_UID}"
        ONLY_DELETE=volume _SOFT_FAIL=1 storpoolDelete "${VOL_UID}" "force" "" "" "" "1"
        kvDel "${CREATE_VOL}"
        splog "[E] replacement ${VOL_UID} (${CREATE_VOL}) not adopted as ${SP_VOL} (${_ret}); ${OLD_UID} kept"
        exit "${_ret}"
    fi
    DELAY_DELETE="" _SOFT_FAIL=1 storpoolDelete "${OLD_UID}" "force" "" "" "" "1" || \
        splog "[W] ${SP_VOL} is ${VOL_UID}; previous ${OLD_UID} not deleted ($?)"
fi
SP_LINK="/dev/storpool-byid/${VOL_UID#*~}"

storpoolAttach "${VOL_UID}" "${DST_HOST}"

if [[ "${FSTYPE,,}" != "raw" ]] || [[ -n "${FS}" ]]; then
    if [[ "${FSTYPE}" == "swap" ]]; then
        # ssh as oneadmin does not have sbin on PATH; fs_lvm/mkimage exports it.
        MKFS_CMD="export PATH=/usr/sbin:/sbin:\$PATH; ${MKSWAP:-mkswap} -L swap \"${SP_LINK}\""
    else
        if [[ -n "${FS}" ]]; then
            FS_OPTS="FS_OPTS_${FS}"
            case "${FS,,}" in
                xfs|btrfs) MKFS_FORCE="-f" ;;
                ext*)      MKFS_FORCE="-F" ;;
                *)         MKFS_FORCE="" ;;
            esac
            # ONE_FS (since 7.4.1) allows /usr/sbin/mkfs only. Older releases
            # need the same sudoers entry; see docs/installation.md. -t before
            # -f/-F: util-linux passes the force flag through (OpenNebula/one#5810).
            MKFS_CMD="${SUDO:-sudo -n} /usr/sbin/mkfs -t \"${FS}\" ${MKFS_FORCE} ${!FS_OPTS} \"${SP_LINK}\""
        else
            MKFS_CMD="$(mkfs_command "${SP_LINK}" "${FSTYPE}" "${SIZE}")"
        fi
    fi
    splog "MKFS_CMD=${MKFS_CMD}"

    # Newest entry runs first: log, detach, delete, then rm $TMPDIR.
    trapAdd "storpoolDelete \"${VOL_UID}\" force snaps"
    trapAdd "storpoolDetach \"${VOL_UID}\" \"force\" \"\" \"all\""
    trapAdd "splog \"return \$?\""

    splog "ssh_exec_and_log ${DST_HOST} ${MKFS_CMD}"
    ssh_exec_and_log "${DST_HOST}" "${MKFS_CMD}" \
            "Error running ${MKFS_CMD} on ${DST_HOST}"

    trapReset
fi

mode="rw"
type="VOL"
if boolTrue "READONLY"; then
    mode="${READONLY_MODE,,}"
    type+="RO"
fi

if [[ -z "${ON_HOST}" ]] || [[ "${mode}" == "ro" ]]; then
    storpoolAttach "${VOL_UID}" "${DST_HOST}" "${mode}"
fi

storpoolVolumeTag "${VOL_UID}" \
    "virt;${LOC_TAG:-nloc};${VM_TAG:-nvm};${VC_POLICY:+vc-policy};${SP_QOSCLASS:+qc};type;diskid" \
    "one;${LOC_TAG_VAL};${VM_ID};${VC_POLICY};${SP_QOSCLASS};${type};${DISK_ID}"

MONITOR_TM_MAD=""
if ! boolTrue "DS_SHARED"; then
    MONITOR_TM_MAD="storpool"
fi

oneSymlink "${DST_HOST}" "${VOL_UID}" "${DST_PATH}"

splog "END ${VM_ID}"
exit 0
