#-------------------------------------------------------------------------------
# snapshot_revert  domain snap_id vm_id vmhost
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
# Get snapshot_revert arguments from OpenNebula core
#-------------------------------------------------------------------------------

DOMAIN="$1"
SNAP_ID="$2"
VM_ID="$3"
VMHOST="$4"

DRIVER_PATH="$(dirname "$0")"
VMSNAPSHOT_TAG="ONESNAP"
VMSNAPSHOT_OVERRIDE=1
#DS_PATH="/var/lib/one/datastores"

if [[ -f "${DRIVER_PATH}/../../etc/vmm/kvm/kvmrc" ]]; then
    # shellcheck source=/dev/null
    source "${DRIVER_PATH}/../../etc/vmm/kvm/kvmrc"
else
    # shellcheck source=/dev/null
    source "${DRIVER_PATH}/kvmrc"
fi
# shellcheck source=/dev/null
source "${DRIVER_PATH}/../../scripts_common.sh"
# shellcheck source=tm/storpool/storpool_common.sh
source "${DRIVER_PATH}/../../tm/storpool/storpool_common.sh"

export LOG_PREFIX="vmm"

if boolTrue "DEBUG_VMSNAPSHOT"; then
    splog "[D] $0 $*"
fi

if boolTrue "VMSNAPSHOT_OVERRIDE"; then
    oneVmVolumes "${VM_ID}"
    oneDatastoreInfo "${VM_DS_ID}"

#    declare -A vmDisks_a diskVolumes vmVolumesQcMap vmDisksReadOnly_a vmDisksType_a
#    for entry in ${vmVolumes}; do
#        diskVolumes["${entry}"]="${entry}"  # diskVolumes[oneName]=oneName
#    done
#    for entry in ${vmDisksMap}; do
#        vmDisks_a["${entry%:*}"]="${entry##*:}"  # vmDisks_a[oneName]=DISK_ID
#    done
#    for entry in ${vmDisksReadOnlyMap}; do
#        vmDisksReadOnly_a["${entry%:*}"]="${entry##*:}"  # vmDisksReadOnly_a[oneName]=READONLY
#    done
#    for entry in ${vmVolumesQc:-}; do
#        vmVolumesQcMap["${entry%:*}"]="${entry##*:}"  # vmVolumesQcMap[oneName]=QOSCLASS
#    done
#    for entry in ${vmDisksTypeMap}; do
#        vmDisksType_a["${entry%:*}"]="${entry##*:}"  # vmDisksType_a[oneName]=xTYPE
#    done

    if boolTrue "MULTICLUSTER"; then
       oneHostInfo "${VMHOST}"
       # RemoteCommand/~/... is "unknown cluster" when the host has no SP_CLUSTER_ID
       [[ -z "${HOST_SP_CLUSTER_ID}" ]] || DO_REMOTE="~${HOST_SP_CLUSTER_ID}"
    fi

    unset vmVolumesMap diskVolumes vmVolumesQcMap
    declare -A vmVolumes_a
    declare -A diskVolumes_a
    declare -A vmVolumesQc_a
    declare -A persistentDisksQc_a
    for volume in ${vmVolumes}; do
        vmVolumes_a["${volume}"]="${volume}"  # vmVolumes_a[VOLUME_NAME]=VOLUME_NAME
    done
    for disk in ${vmDisksMap}; do
        diskVolumes_a["${disk%:*}"]="${disk##*:}"  # diskVolumes_a[VOLUME_NAME]=DISK_ID
    done

    for volume in ${vmDisksQcMap}; do
        vmVolumesQc_a["${volume%%:*}"]="${volume##*:}"  # vmVolumesQc_a[VOLUME_NAME]=QOSCLASS
    done
    for volume in ${persistentDisksQcMap}; do
        persistentDisksQc_a["${volume%%:*}"]="${volume##*:}"  # persistentDisksQc_a[VOLUME_NAME]=QOSCLASS
    done

# TBD: check is needed
#    if boolTrue "VMSNAPSHOT_WITH_CHECKPOINT"; then
#        MEM_VOL="${ONE_PX}-sys-${VM_ID}"
#        diskVolumes["$MEM_VOL"]="$MEM_VOL3"
#    fi

    if [[ -n "${TPM_MODEL}" ]]; then
        SWTPM_VOL="${ONE_PX}-sys-${VM_ID}-SWTPM"
        vmVolumes_a["${SWTPM_VOL}"]="${SWTPM_VOL}"
        diskVolumes_a["${SWTPM_VOL}"]="tpm"
    fi

    export vmVolumes_a

    rCMD=$(cat <<EOF
    [[ -f "/var/tmp/one/etc/vmm/kvm/kvmrc" ]] && source "/var/tmp/one/etc/vmm/kvm/kvmrc" || source "/var/tmp/one/vmm/kvm/kvmrc"
	# A second attempt covers a monitor holding the state-change lock, and a
	# destroy that killed QEMU but still returned an error.
	vret=1
	for _try in 1 2; do
		vret=0
		virsh --connect "\$LIBVIRT_URI" destroy "${DOMAIN}" >"/tmp/sprevert-${VM_ID}-destroy.log" 2>&1 || vret=\$?
		while read -r out; do
			logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} virsh: \$out"
		done <"/tmp/sprevert-${VM_ID}-destroy.log"
		if [[ \$vret -eq 0 ]]; then
			logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} virsh destroy ${DOMAIN} ret:0"
			break
		fi
		if grep -qiE 'not running|Domain not found' "/tmp/sprevert-${VM_ID}-destroy.log"; then
			logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} virsh destroy ${DOMAIN} ret:\$vret (domain already stopped)"
			vret=0
			break
		fi
		logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} virsh destroy ${DOMAIN} ret:\$vret (attempt \$_try)"
		if [[ \$_try -eq 1 ]]; then
			sleep 1
		fi
	done
	[[ \$vret -eq 0 ]] || cat "/tmp/sprevert-${VM_ID}-destroy.log" >&2
	exit \$vret
EOF
)
    RESTART_DOMAIN=0
    if boolTrue "VMSNAPSHOT_RESTARTDOMAIN"; then
        RESTART_DOMAIN=1
        restartDomainDirname="/var/lib/one/datastores/${VM_DS_ID}/${VM_ID}"
        restartDomain="${restartDomainDirname}/$(mktemp -u restart-XXXXXX).domain"
        rCMD=$(cat <<EOF
    [[ -f "/var/tmp/one/etc/vmm/kvm/kvmrc" ]] && source "/var/tmp/one/etc/vmm/kvm/kvmrc" || source "/var/tmp/one/vmm/kvm/kvmrc"
    mkdir -p "${restartDomainDirname}"
    if grep -q "</domain>" "${restartDomain}" 2>/dev/null; then
        logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} restart XML ${restartDomain} already present, skipping dumpxml"
    else
        virsh --connect "\$LIBVIRT_URI" dumpxml "${DOMAIN}" 2>"/tmp/sprevert-${VM_ID}-dumpxml.err" >"${restartDomain}"
        dret=\$?
        logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} virsh dumpxml ${DOMAIN} > ${restartDomain} ret:\$dret"
        if [[ \$dret -ne 0 ]] || ! grep -q "</domain>" "${restartDomain}"; then
            logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} domain XML dump failed: \$(cat /tmp/sprevert-${VM_ID}-dumpxml.err)"
            rm -f "${restartDomain}"
            exit 3
        fi
    fi
	vret=1
	for _try in 1 2; do
		vret=0
		virsh --connect "\$LIBVIRT_URI" destroy "${DOMAIN}" >"/tmp/sprevert-${VM_ID}-destroy.log" 2>&1 || vret=\$?
		while read -r out; do
			logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} virsh: \$out"
		done <"/tmp/sprevert-${VM_ID}-destroy.log"
		if [[ \$vret -eq 0 ]]; then
			logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} virsh destroy ${DOMAIN} ret:0"
			break
		fi
		if grep -qiE 'not running|Domain not found' "/tmp/sprevert-${VM_ID}-destroy.log"; then
			logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} virsh destroy ${DOMAIN} ret:\$vret (domain already stopped)"
			vret=0
			break
		fi
		logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} virsh destroy ${DOMAIN} ret:\$vret (attempt \$_try)"
		if [[ \$_try -eq 1 ]]; then
			sleep 1
		fi
	done
	[[ \$vret -eq 0 ]] || cat "/tmp/sprevert-${VM_ID}-destroy.log" >&2
	exit \$vret
EOF
)
    fi
    ${SSH:-ssh} "${VMHOST}" "${rCMD}" 2>"/tmp/sprevert-${VM_ID}-destroy.err" >"/tmp/sprevert-${VM_ID}-desctroy.out"
    ret=$?
    # 255 is ssh itself (connection dropped). The remote status is passed through.
    if [[ ${ret} -eq 255 ]]; then
        splog "[W] VM ${VM_ID} host:${VMHOST} ssh failed (${ret}), retrying the destroy once"
        sleep 1
        ${SSH:-ssh} "${VMHOST}" "${rCMD}" 2>"/tmp/sprevert-${VM_ID}-destroy.err" >"/tmp/sprevert-${VM_ID}-desctroy.out"
        ret=$?
    fi
    if [[ ${ret} -eq 3 ]] && boolTrue "RESTART_DOMAIN"; then
        # the domain is still running: destroy it without the restart (the old behaviour)
        splog "[W] VM ${VM_ID} host:${VMHOST} DOMAIN_ID:${DOMAIN} domain XML dump failed, the domain will not be restarted"
        RESTART_DOMAIN=0
        rCMD=$(cat <<EOF
    [[ -f "/var/tmp/one/etc/vmm/kvm/kvmrc" ]] && source "/var/tmp/one/etc/vmm/kvm/kvmrc" || source "/var/tmp/one/vmm/kvm/kvmrc"
	vret=1
	for _try in 1 2; do
		vret=0
		virsh --connect "\$LIBVIRT_URI" destroy "${DOMAIN}" >"/tmp/sprevert-${VM_ID}-destroy.log" 2>&1 || vret=\$?
		while read -r out; do
			logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} virsh: \$out"
		done <"/tmp/sprevert-${VM_ID}-destroy.log"
		if [[ \$vret -eq 0 ]]; then
			logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} virsh destroy ${DOMAIN} ret:0"
			break
		fi
		if grep -qiE 'not running|Domain not found' "/tmp/sprevert-${VM_ID}-destroy.log"; then
			logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} virsh destroy ${DOMAIN} ret:\$vret (domain already stopped)"
			vret=0
			break
		fi
		logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} virsh destroy ${DOMAIN} ret:\$vret (attempt \$_try)"
		if [[ \$_try -eq 1 ]]; then
			sleep 1
		fi
	done
	[[ \$vret -eq 0 ]] || cat "/tmp/sprevert-${VM_ID}-destroy.log" >&2
	exit \$vret
EOF
)
        ${SSH:-ssh} "${VMHOST}" "${rCMD}" 2>"/tmp/sprevert-${VM_ID}-destroy.err" >"/tmp/sprevert-${VM_ID}-desctroy.out"
        ret=$?
        if [[ ${ret} -eq 255 ]]; then
            splog "[W] VM ${VM_ID} host:${VMHOST} ssh failed (${ret}), retrying the destroy once"
            sleep 1
            ${SSH:-ssh} "${VMHOST}" "${rCMD}" 2>"/tmp/sprevert-${VM_ID}-destroy.err" >"/tmp/sprevert-${VM_ID}-desctroy.out"
            ret=$?
        fi
    fi
    if [[ ${ret} -ne 0 ]]; then
        splog "[E] VM ${VM_ID} host:${VMHOST} DOMAIN_ID:${DOMAIN} was not destroyed (${ret}), snapshot revert aborted"
        log_error "VM ${VM_ID} snapshot revert aborted, the domain on ${VMHOST} was not destroyed (${ret})"
        exit "${ret}"
    fi
    splog "VM ${VM_ID} host:${VMHOST} DOMAIN_ID:${DOMAIN} destroyed (${ret})${RESTART_DOMAIN:+ restart XML:${restartDomain}}"
    sleep .5
    declare -a snapList_a=()
    MEM_VOL="${ONE_PX}-sys-${VM_ID}"
    DO_MULTICLUSTER=1 DO_ALLCLUSTERS=1 DO_REMOTE="" storpoolRetry SnapshotsList
    while read -r -u "${jqfh}" sp_uid img loctagval; do
        if boolTrue "DDEBUG_VMSNAPSHOT"; then
            splog "snapshot sp_uid:${sp_uid} tag img:${img} ${LOC_TAG}:${loctagval}"
        fi
        if [[ "${img}" == "${MEM_VOL}" ]]; then
            continue
        fi
        if [[ -z "${vmVolumes_a["${img}"]}" ]]; then
            if boolTrue "DEBUG_VMSNAPSHOT"; then
                splog "[D] VM ${VM_ID} Skip snapshot ${sp_uid} for ${img} (not in vmVolumes:${!vmVolumes_a[*]})"
            fi
            continue
        fi
        snapList_a+=("${sp_uid}-${img}-${SNAP_ID}")
    done {jqfh}< <(jq -r --arg snap_id "${SNAP_ID}" --arg vm_tag "${VM_TAG}" --arg vm_id "${VM_ID}" --arg loctag "${LOC_TAG}" \
                  '(if (.data|type)=="array" then .data[] else .data.clusters[].response.data[]? end)
                   |select(.tags[$vm_tag]==$vm_id)|select(.tags["snap"]==$snap_id)|select(.deleted==false)|"\(.name) \(.tags["img"]|tostring) \(.tags[$loctag]|tostring)"' \
                  "${TMPDIR}/SnapshotsList.json" || true)
    exec {jqfh}<&-

    boolTrue "UPDATE_ONE_DISK_SIZE" && REVERT_SIZE=1 || REVERT_SIZE=0

    splog "snapList_a: [${snapList_a[*]}]"
    finish=1
    for snapentry in "${snapList_a[@]}"; do
        tb="$(date +%s%N)"
        splog "-=[B]=- snapshot ${snapentry} (${tb})"
        snapUid="${snapentry%%-*}"
        snap="${snapentry#*-}"
        volume="${snap%-"${SNAP_ID}"}"
        sp_uid=$(kvGet "byName" "${volume}")
        if [[ -z ${sp_uid} ]]; then
            splog "Can't get StorPool UID for ${volume} //next"
            finish=0
            continue
        fi
        [[ ${volume%-iso} == "${volume}" ]] && mode="rw" || mode="${READONLY_MODE}"

        VM_DISK_SP_QOSCLASS="${vmVolumesQc_a[${volume}]}"
        IMAGE_SP_QOSCLASS="${persistentDisksQc_a[${volume}]}"

        SP_QOSCLASS="${VM_DISK_SP_QOSCLASS:-${IMAGE_SP_QOSCLASS:-${VM_SP_QOSCLASS:-${DS_SP_QOSCLASS:-${DEFAULT_QOSCLASS}}}}}"
        debug_sp_qosclass

        storpoolVolumeInfo "${sp_uid}"
        if [[ "${V_TYPE}" == "CDROM" ]]; then
            mode="${READONLY_MODE}"
        fi

        if boolTrue "DDEBUG_VMSNAPSHOT"; then
            splog "[DD] volume ${sp_uid}::${volume} snapshot ${snapUid}::${snap} ${mode}"
        fi
        storpoolDetach "${sp_uid}" "force" "${VMHOST}" "all"
        trapAdd "storpoolAttach \"${sp_uid}\" \"${VMHOST}\" \"${mode}\""
        storpoolVolumeRevert "${sp_uid}" "${volume}" "${snapUid}" "${REMOTE_BACKUP_DELETE}" "${REVERT_SIZE}" "vm_snap_revert" || exit $?
        if boolTrue "REVERT_SIZE"; then
            OLD_SIZE_M=$((V_SIZE/1024/1024))
            storpoolVolumeInfo "~${SP_GLOBALID}"
            NEW_SIZE_M=$((V_SIZE/1024/1024))
            if [[ ${OLD_SIZE_M} -ne ${NEW_SIZE_M} ]]; then
                if [[ -n "${diskVolumes_a["${volume}"]}" ]]; then
                    DISK_ID="${diskVolumes_a[${volume}]}"
                    onedb change-body vm --id "${VM_ID}" "/VM/TEMPLATE/DISK[DISK_ID=${DISK_ID}]/SIZE" "${NEW_SIZE_M}"
                    splog "[I] onedb change VM_ID:${VM_ID} DISK_ID:${DISK_ID} SIZE:${NEW_SIZE_M} (OLD_SIZE:${OLD_SIZE_M}) ($?)"
                else
                    splog "[W] diskVolumes_a[${volume}] not found"
                fi
            else
                splog "[I] (old size:${OLD_SIZE_M}) == (${volume}:${NEW_SIZE_M}) sp_uid:${sp_uid}"
            fi
        fi
        storpoolAttach "${sp_uid}" "${VMHOST}" "${mode}"
        trapReset
#        SYMLINK="/var/lib/one/datastores/${VM_DS_ID}/${VM_ID}/disk.${vmVolumesMap["${volume}"]}"
#        oneSymlink "${VMHOST}" "${sp_uid}" "${SYMLINK}" || finish=0

        diskid="${diskVolumes_a["${volume}"]}"  # empty for the NVRAM volume
        storpoolVolumeTag "${sp_uid}" \
            "virt;${LOC_TAG};${diskid:+diskid};${VM_TAG};${VC_POLICY:+vc-policy};${SP_QOSCLASS:+qc}" \
             "one;${LOC_TAG_VAL};${diskid};${VM_ID};${VC_POLICY};${SP_QOSCLASS}"
        te="$(date +%s%N)"
        splog "-=[E]=- snapshot ${snapentry} (${te} dt:$((te-tb)))"
    done
    if boolTrue "RESTART_DOMAIN"; then
        # the ssh exit status must be the one of virsh create, not of the logger call after it
        rCMD=$(cat <<EOF
    [[ -f "/var/tmp/one/etc/vmm/kvm/kvmrc" ]] && source "/var/tmp/one/etc/vmm/kvm/kvmrc" || source "/var/tmp/one/vmm/kvm/kvmrc"
    virsh --connect "\$LIBVIRT_URI" create "${restartDomain}" >"/tmp/sprevert-${VM_ID}-create.log" 2>&1
    cret=\$?
    while read -r out; do
        logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} virsh: \$out"
    done <"/tmp/sprevert-${VM_ID}-create.log"
    logger -t vmm_sp_snapshot_revert_r "VM ${VM_ID} virsh create ${restartDomain} //${DOMAIN} ret:\$cret"
    if [[ \$cret -eq 0 ]]; then
        rm -f "${restartDomain}" "/tmp/sprevert-${VM_ID}"*
    else
        cat "/tmp/sprevert-${VM_ID}-create.log" >&2
    fi
    exit \$cret
EOF
)
        ${SSH:-ssh} "${VMHOST}" "${rCMD}" 2>"/tmp/sprevert-${VM_ID}-create.err" >"/tmp/sprevert-${VM_ID}-create.out"
        ret=$?
        if [[ ${ret} -eq 0 ]]; then
            splog "VM ${VM_ID} host:${VMHOST} DOMAIN_ID:${DOMAIN} restarted XML:${restartDomain}"
            rm -f "/tmp/sprevert-${VM_ID}"*
        else
            # shellcheck disable=SC2002,SC2312
            splog "[W] VM ${VM_ID} host:${VMHOST} DOMAIN_ID:${DOMAIN} failed to restart from ${restartDomain} (${ret}): $(cat "/tmp/sprevert-${VM_ID}-create.err" 2>/dev/null | tr '\n' ' ')"
            log_error "VM ${VM_ID} volumes reverted but the domain could not be restarted (${ret}), resume the VM"
        fi
    fi
    splog "END VM ${VM_ID} VMHOST=${VMHOST} SNAP_ID=${SNAP_ID}"
    exit 0
else
    splog "[CONTINUE] VM ${VM_ID}"
fi
