WORKDIR="$(dirname "$0")"
# shellcheck source=/dev/null
source "${WORKDIR}/../../etc/vmm/kvm/kvmrc"
# shellcheck source=/dev/null
source "${WORKDIR}/../../scripts_common.sh"
if [[ -f "${WORKDIR}/../../addon-storpoolrc" ]]; then
    # shellcheck source=addon-storpoolrc
    source "${WORKDIR}/../../addon-storpoolrc"
fi
SPXML="${WORKDIR}/../../datastore/spxml.py"

set -o pipefail

function splog()
{
    logger -t "vmm_sp_${0##*/}" "[$$] ${DEBUG_LINENO:+[${BASH_LINENO[-2]}]}$*"
}

if [[ -n "${DEBUG_ATTACH_DISK}" ]]; then
    splog "[D] $0 $1 $2 $3 $4 ${5:0:8}"
fi

DRV_ACTION="$5"

unset i XPATH_ELEMENTS
while IFS='' read -r -u "${xfh}" -d '' element; do
    XPATH_ELEMENTS[i++]="${element}"
done {xfh}< <("${SPXML}" get -b \
    '//HISTORY[last()]/HOSTNAME' \
    '//DISK[ATTACH="YES"]/TM_MAD' \
    '//DISK[ATTACH="YES"]/DISK_TYPE' \
    '//DISK[ATTACH="YES"]/TYPE' \
    '//DISK[ATTACH="YES"]/DEV_PREFIX' \
    '//DISK[ATTACH="YES"]/DISK_ID' \
    '//USER_TEMPLATE/T_PERSISTENT_CDROM' <<< "${DRV_ACTION}" || true)
exec {xfh}<&-
unset i
KVMHOST="${XPATH_ELEMENTS[i++]}"
TM_MAD="${XPATH_ELEMENTS[i++]}"
DISK_TYPE="${XPATH_ELEMENTS[i++]}"
TYPE="${XPATH_ELEMENTS[i++]}"
DEV_PREFIX="${XPATH_ELEMENTS[i++]}"
DISK_ID="${XPATH_ELEMENTS[i++]}"
T_PERSISTENT_CDROM_VM="${XPATH_ELEMENTS[i++]}"

PERSISTENT_CDROM="${T_PERSISTENT_CDROM_VM:-${T_PERSISTENT_CDROM}}"
PERSISTENT_CDROM="${PERSISTENT_CDROM//[[:space:]]/}"

DEV_PREFIX="${DEV_PREFIX:-${3:0:2}}"  # workaround a bug in 7.2.[0-1]

if [[ -n "${DEBUG_ATTACH_DISK}" ]]; then
    splog "[D] KVMHOST=${KVMHOST} TM_MAD=${TM_MAD} DISK_TYPE=${DISK_TYPE} TYPE=${TYPE} PERSISTENT_CDROM=${PERSISTENT_CDROM} DEV_PREFIX=${DEV_PREFIX}"
    if [[ -n "${DDDEBUG_ATTACH_DISK}" ]]; then
        echo "${DRV_ACTION}" >/tmp/atach_disk.b64
    fi
fi

# USER_TEMPLATE/T_PERSISTENT_CDROM=0 disables the feature for this VM.
# A non-empty "0" must not count as enabled.
if [[ "${PERSISTENT_CDROM}" =~ ^[0-9]+$ ]] && [[ "$((10#${PERSISTENT_CDROM}))" -gt 0 ]]; then
    if [[ "${TYPE^^}" == "CDROM" ]]; then
        case "${DEV_PREFIX,,}" in
            hd|sd|[a-z])
                set -o pipefail
                ${SSH:-ssh} "${KVMHOST}" "${REMOTE_LOCATION:-/var/tmp/one}/vmm/kvm/attach_disk.cdrom" "$@"
                ret=$?
                splog "(${ret}) ${SSH:-ssh} ${KVMHOST} ${REMOTE_LOCATION:-/var/tmp/one}/vmm/kvm/attach_disk.cdrom $1 $2 $3 $4 <DRV_ACTION>"
                exit "${ret}"
                ;;
            *)
                splog "VM ${VM_ID:-} DISK_ID=${DISK_ID} DISK_TYPE=${DISK_TYPE} TYPE=${TYPE} DEV_PREFIX='${DEV_PREFIX}' not supported for persistent CDROM"
                ;;
        esac
    fi
fi

if [[ "${TM_MAD:0:8}" == "storpool" ]]; then
    if [[ "${DISK_TYPE^^}" == "BLOCK" && "${TYPE^^}" == "BLOCK" ]]; then
        splog "Disk $1 $2 $3 DISK_TYPE '${DISK_TYPE}', TYPE '${TYPE}'"
    else
        case "${TYPE^^}" in
            CDROM)
                NEW_TYPE="CDROM"
                ;;
            *)
                NEW_TYPE="BLOCK"
                ;;
        esac
        splog "Replacing $1 $2 $3 DISK_TYPE '${DISK_TYPE}' to BLOCK and TYPE '${TYPE}' to ${NEW_TYPE}"
        DRV_ACTION="$("${SPXML}" ed -b -u '//DISK[ATTACH="YES"]/DISK_TYPE' -v BLOCK \
                   -u '//DISK[ATTACH="YES"]/TYPE' -v "${NEW_TYPE}" <<< "${DRV_ACTION}" |\
                   base64 -w 0 || true)"
        if [[ -n "${DDDEBUG_ATTACH_DISK}" ]]; then
            echo "${DRV_ACTION}" >/tmp/atach_disk_out.b64
        fi
    fi
fi

${SSH:-ssh} "${KVMHOST}" "\"${REMOTE_LOCATION:-/var/tmp/one}/vmm/kvm/attach_disk\" \"$1\" \"$2\" \"$3\" \"$4\" \"${DRV_ACTION}\""
